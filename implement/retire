#!/usr/bin/env bash
# retire — the root's teardown after a worker reports `landed`: close the worker's pane in the
# `workers` tab, remove its worktree, and delete its branch.
#
#   retire <repo> <item-id>
#
# Refuses, removing nothing, when the worktree is dirty or its branch carries commits the
# default branch on origin does not. The pane (WORKER-PANE in the worktree's git dir) is closed
# first, which ends the worker session standing in the worktree, so the removal after it never
# pulls a directory out from under a live process.
# Exit 0 retired, 1 refused (reason on stderr), 2 usage.
set -euo pipefail

repo_in="${1:-}"; id="${2:-}"
[ -n "$repo_in" ] && [ -n "$id" ] || { echo "usage: retire <repo> <item-id>" >&2; exit 2; }
die() { echo "retire: $*" >&2; exit 1; }

repo=$(git -C "$repo_in" rev-parse --show-toplevel 2>/dev/null) || die "$repo_in is not a git repo"
wt="$HOME/.worktrees/$(basename "$repo")/$id"
branch="bead/$id"
[ -d "$wt" ] || die "no worktree at $wt"

[ -z "$(git -C "$wt" status --short -- . ':(exclude).beads' ':(exclude).claude')" ] || die "$wt has uncommitted changes"
default=$(git -C "$repo" symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null || echo origin/main)
git -C "$repo" fetch --quiet origin "${default#origin/}" || die "fetch of $default failed"
[ -z "$(git -C "$repo" log --oneline "$default..$branch" 2>/dev/null)" ] || die "$branch has commits $default does not — it has not landed"

pane=$(head -1 "$(git -C "$wt" rev-parse --absolute-git-dir)/WORKER-PANE" 2>/dev/null || true)
[ -n "$pane" ] && herdr pane close "$pane" >/dev/null 2>&1 || true
git -C "$repo" worktree remove --force "$wt"
git -C "$repo" worktree prune
git -C "$repo" branch -D "$branch" >/dev/null 2>&1 || true
echo "retired $id: ${pane:+pane $pane, }$wt, $branch"

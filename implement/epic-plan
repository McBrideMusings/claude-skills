#!/usr/bin/env python3
"""epic-plan — turn a beads epic into an ordered plan, straight from the tracker.

    epic-plan [--json] <repo> <epic-id>

Reads the epic's children with `bd children`, their blocking edges with `bd show --json`, and
the unblocked front with `bd ready --parent`, then prints every open child in dependency order:

  waves    open slices grouped by depth — wave 1 is the unblocked front, wave N waits on
           something in wave N-1. Items in one wave share no edge and can run at once.
  person   open slices labelled `human` — a person does them; listed with their wave.
  verify   the epic's `Verify:` children — run by the root via verify-project once every
           slice it waits on is closed.
  land     the epic's `Land:` children — run through wrap-up after Verify.
  done     closed children, for context.

A child that is itself an epic is expanded in place, one level at a time, so a nested
breakdown plans as one graph. Edges to issues outside the epic are reported as `external`
blockers, never followed. Exit 0 printed, 1 bd failed or the id is not an epic, 2 usage.
"""
import json, subprocess, sys

def bd(repo, *args):
    out = subprocess.run(["bd", "-C", repo, *args, "--json"], capture_output=True, text=True)
    if out.returncode != 0:
        sys.exit(f"epic-plan: bd {' '.join(args)} failed: {out.stderr.strip()[:200]}")
    data = json.loads(out.stdout or "[]")
    return data

def one(x):
    return x[0] if isinstance(x, list) else x

def main():
    argv = sys.argv[1:]
    as_json = "--json" in argv
    argv = [a for a in argv if a != "--json"]
    if len(argv) != 2:
        print("usage: epic-plan [--json] <repo> <epic-id>", file=sys.stderr); sys.exit(2)
    repo, epic = argv
    head = one(bd(repo, "show", epic))
    if head.get("issue_type") != "epic":
        sys.exit(f"epic-plan: {epic} is a {head.get('issue_type')}, not an epic — implement it directly")

    items, stack = {}, [epic]
    while stack:
        parent = stack.pop()
        for c in bd(repo, "children", parent):
            if c.get("issue_type") == "epic":
                stack.append(c["id"])
                continue
            items[c["id"]] = c
    ready = {r["id"] for r in bd(repo, "ready", "--parent", epic, "--limit", "0")}

    blockers = {}
    for cid, c in items.items():
        if c.get("status") == "closed":
            continue
        deps = one(bd(repo, "show", cid)).get("dependencies") or []
        blockers[cid] = [d["id"] for d in deps if d.get("dependency_type") == "blocks"]

    open_ids = [i for i, c in items.items() if c.get("status") != "closed"]
    depth = {}
    def level(i, seen=()):
        if i in depth: return depth[i]
        if i in seen: return 1                      # a cycle: bd should not allow it; don't loop
        inner = [b for b in blockers.get(i, []) if b in items and items[b].get("status") != "closed"]
        depth[i] = 1 + max((level(b, seen + (i,)) for b in inner), default=0)
        return depth[i]
    for i in open_ids: level(i)

    def row(i):
        c = items[i]
        ext = [b for b in blockers.get(i, []) if b not in items]
        return {"id": i, "title": c.get("title", ""), "wave": depth[i], "ready": i in ready,
                "labels": c.get("labels") or [], "external_blockers": ext,
                "blocked_by": [b for b in blockers.get(i, []) if b in items and items[b].get("status") != "closed"]}
    kind = lambda i: ("verify" if items[i].get("title", "").startswith("Verify:") else
                      "land" if items[i].get("title", "").startswith("Land:") else
                      "person" if "human" in (items[i].get("labels") or []) else "slice")
    plan = {"epic": {"id": epic, "title": head.get("title", "")},
            "waves": {}, "person": [], "verify": [], "land": [],
            "done": [{"id": i, "title": c.get("title", "")} for i, c in items.items() if c.get("status") == "closed"]}
    for i in sorted(open_ids, key=lambda i: (depth[i], i)):
        k = kind(i)
        if k == "slice": plan["waves"].setdefault(str(depth[i]), []).append(row(i))
        else: plan[k].append(row(i))

    if as_json:
        print(json.dumps(plan, indent=2)); return
    print(f"{epic} — {head.get('title','')}")
    for w, rows in plan["waves"].items():
        print(f"\nwave {w}" + (" (unblocked now)" if w == "1" else ""))
        for r in rows:
            extra = f"  after {', '.join(r['blocked_by'])}" if r["blocked_by"] else ""
            extra += f"  external: {', '.join(r['external_blockers'])}" if r["external_blockers"] else ""
            print(f"  {r['id']}  {r['title']}{extra}")
    for k, label in (("person", "needs a person"), ("verify", "verify (root, via verify-project)"), ("land", "land (wrap-up)")):
        if plan[k]:
            print(f"\n{label}")
            for r in plan[k]:
                extra = f"  after {', '.join(r['blocked_by'])}" if r["blocked_by"] else ""
                print(f"  {r['id']}  {r['title']}{extra}" + ("  ready" if r["ready"] else ""))
    if plan["done"]:
        print(f"\ndone: {', '.join(d['id'] for d in plan['done'])}")
    if not open_ids:
        print("\nnothing open — the epic can close")

main()

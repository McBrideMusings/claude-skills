#!/usr/bin/env bash
# launch — start one implement worker: its own claude session in a pane of the root's `workers`
# tab, standing in its own worktree, reporting every stop back to the calling (root) pane.
#
#   launch [--auto] <repo> <item-id>
#
# Makes ~/.worktrees/<repo-name>/<item-id> on branch bead/<item-id>, cut from the repo's
# default branch; links its local files; marks it SELF-LAND; writes the worker brief
# (WORKER.md, filled in) to DISPATCH-BRIEF.md and the root pane and item id to WORKER-ROOT and
# WORKER-ID in its git dir; and starts `dispatch exec` DETACHED, with HERDR_AGENT_TAB=workers so
# the pane opens in the root workspace's `workers` tab (created on first use, split after). This
# returns as soon as the launch is under way. The worker reports through hooks/worker-report.sh,
# which reads WORKER-ROOT — never through this process. Launcher output goes to WORKER.log.
#
# Requires herdr (HERDR_PANE_ID names the root pane the worker will talk to).
# Exit 0 launched, 1 refused (reason on stderr), 2 usage.
set -euo pipefail

auto=0
if [ "${1:-}" = "--auto" ]; then auto=1; shift; fi
repo_in="${1:-}"; id="${2:-}"
[ -n "$repo_in" ] && [ -n "$id" ] || { echo "usage: launch [--auto] <repo> <item-id>" >&2; exit 2; }

die() { echo "launch: $*" >&2; exit 1; }

[ "${HERDR_ENV:-}" = "1" ] && [ -n "${HERDR_PANE_ID:-}" ] || die "not inside herdr — run \`implement $id inline\` instead"
repo=$(git -C "$repo_in" rev-parse --show-toplevel 2>/dev/null) || die "$repo_in is not a git repo"

default=$(git -C "$repo" symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null || true)
default=${default#origin/}
[ -n "$default" ] || default=main
git -C "$repo" rev-parse --verify --quiet "$default" >/dev/null || die "default branch '$default' not found in $repo"

item=$(bd -C "$repo" show "$id" --json 2>/dev/null) || die "bd -C $repo show $id failed"
title=$(printf '%s' "$item" | jq -r 'if type=="array" then .[0] else . end | .title // empty')
[ -n "$title" ] || die "$id has no title in $repo's tracker"

wt="$HOME/.worktrees/$(basename "$repo")/$id"
branch="bead/$id"
[ -e "$wt" ] && die "$wt already exists — a worker for $id may already be running"

git -C "$repo" worktree add -q -b "$branch" "$wt" "$default"
CLAUDE_PROJECT_DIR="$wt" bash "$HOME/.claude/hooks/worktree-link-locals.sh" >/dev/null 2>&1 || true
gitdir=$(git -C "$wt" rev-parse --absolute-git-dir)
touch "$gitdir/SELF-LAND"
printf '%s\n' "$HERDR_PANE_ID" > "$gitdir/WORKER-ROOT"
printf '%s\n' "$id" > "$gitdir/WORKER-ID"

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
brief="$gitdir/DISPATCH-BRIEF.md"
ITEM_JSON="$item" ID="$id" TITLE="$title" WORKTREE="$wt" BRANCH="$branch" REPO="$repo" \
ROOT_PANE="$HERDR_PANE_ID" AUTO="$auto" TEMPLATE="$here/WORKER.md" OUT="$brief" \
/usr/bin/python3 - <<'PY'
import json, os
t = open(os.environ["TEMPLATE"]).read()
body = t.split("\n---\n")[1]          # the brief is the text between the two rules
it = json.loads(os.environ["ITEM_JSON"])
it = it[0] if isinstance(it, list) else it
parts = [it.get("description") or ""]
if it.get("acceptance_criteria") or it.get("acceptance"):
    parts.append("**Acceptance:** " + (it.get("acceptance_criteria") or it.get("acceptance")))
auto = ("**This is an `auto` run:** if every check passed and nothing needs pierce, do not stop "
        "at the gate — treat it as `go` and continue to `wrap-up`, ending with `landed <sha>`. Stop "
        "at the gate only when something failed or needs pierce.") if os.environ["AUTO"] == "1" else ""
for k, v in {"ID": os.environ["ID"], "TITLE": os.environ["TITLE"], "WORKTREE": os.environ["WORKTREE"],
             "BRANCH": os.environ["BRANCH"], "REPO": os.environ["REPO"],
             "ROOT_PANE": os.environ["ROOT_PANE"], "ITEM": "\n\n".join(p for p in parts if p).strip(),
             "AUTO": auto}.items():
    body = body.replace("{{" + k + "}}", v)
open(os.environ["OUT"], "w").write(body.strip() + "\n")
PY

(
  cd "$wt"
  HERDR_AGENT_TAB=workers HERDR_AGENT_BARE_PROMPT=1 \
  CLAUDE_DELEGATE_AGENT=claude CLAUDE_DELEGATE_MODEL="${WORKER_MODEL:-sonnet}" \
    nohup "$here/../dispatch/dispatch" exec "$brief" "$gitdir/WORKER-OUT.md" \
    > "$gitdir/WORKER.log" 2>&1 &
)

echo "Launched $id in the workers tab ($wt, $branch). Its questions and its gate come back to this chat; pierce answers here, never in the worker's pane."

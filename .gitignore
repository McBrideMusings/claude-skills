.DS_Store

# Scratch, per the global rule that tmp/ is gitignored in every repo including
# this one. Papercut and followup logs are working notes, not repo content —
# tracking them left the submodule permanently dirty against an entry nobody
# was going to commit.
tmp/

# Installed and updated by tldraw offline (Develop -> Install Agent Skills).
# Theirs to change, not ours to track.
tldraw-offline/

# Installed via `npx skills add ogulcancelik/herdr` — third-party skill (symlink into ~/.agents), theirs to update, not ours to track.
herdr

# Python bytecode from the audit-session scanners. Running adherence.py left the
# submodule dirty on every invocation.
__pycache__/

# The private half of the domain store: hosts, accounts, services. Never tracked —
# this repo is public. The hooks read these dirs beside the public ref-* cells.
ref-local-*/

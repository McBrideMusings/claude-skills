#!/usr/bin/env bash
# swarm — launch one bead as an unattended Claude implement pass in its own worktree, and
# keep the swarm's heavy work (builds, tests) to one at a time.
#
#   swarm check
#   swarm launch <bead-id> <haiku|sonnet|opus> [--opus-reason "<text>"] [--dry-run]
#   swarm heavy -- <command> [<arg>...]
#   swarm close <bead-id> landed|parked   close a finished worker's space or pane; landed also
#                                     removes its worktree
#   swarm quota                       the repo's profile's 5-hour and weekly usage, and the gate
#   swarm log <event> [<bead-id>] [<detail>]   append a lead event to the run log (run, lead, filed,
#                                     landed, reopened, parked, failed, ready, signed, declined,
#                                     applied, end)
#   swarm status                      the run log, the launched beads still in flight, and the
#                                     sign-off inbox
#
# The run log, <scratch>/swarm/run.tsv, is the run's state on disk: launch writes `launched`
# and `finished`, the lead writes `run`, `landed`, `reopened`, `parked`, `failed`, `applied` and,
# last, `end`. `reopened` is a bead the lead found not verified and reopened; `failed` is only a
# worker that died or handed back no usable report.
# In sign-off mode the lead writes `ready` when a worker's committed branch checks out, and
# `signed` or `declined` when the user answers its package; a `ready` with neither after it is
# in the sign-off inbox.
# `run` records the lead's pid and the herdr space's label (`pid=<n> space=<label>`); `end` marks
# the run finished. A lead that was compacted, relayed or restarted reads `swarm status` first,
# writes `lead` (its own pid, `pid=<n>`) and carries on. next-work and the swarm page take the
# newest pid of the `run` and `lead` lines, and count the run live while it has no `end` and that
# pid is alive.
#
# launch claims the bead (`bd update --claim`, status in_progress) before anything else, so no
# other picker offers it, and refuses while the profile's usage is at or over SWARM_QUOTA_SESSION
# (5-hour, default 90) or SWARM_QUOTA_WEEKLY (default 90) percent, exiting 5.
#
# Run check and launch from the repo's main checkout. `launch` makes the worktree and branch
# swarm/<bead-id> under ~/.worktrees/<repo>/, links its local files, writes the brief to the
# worktree's git dir, and runs `dispatch exec` there as a claude worker with the runtime's and
# the project's worker environment. The worker runs `implement <bead-id> auto`. The repo's tier
# sets the landing mode: `owned` is self-land (the worktree is marked SELF-LAND; the worker lands
# its branch and closes the bead), `collaborative` is sign-off (SWARM_SIGNOFF=1; the worker
# commits, pushes nothing, and writes a sign-off package for the lead to bring to the user),
# `unlisted` is refused. `launch` blocks until the worker is idle or done; the lead runs one per
# slot in the background.
#
# `heavy` runs <command> holding one lock per repo, shared by every worktree of it
# (<git common dir>/swarm-heavy.lock), so the swarm's builds and test runs take turns. The
# kernel drops the lock when its holder exits, so a crashed worker cannot leave it held.
#
# Worker environment, applied in this order (later wins):
#   1. runtime defaults: rust → CARGO_TARGET_DIR=<worktree>/target (cloned from <main>/target),
#      rust-analyzer plugin off
#   2. <main>/.claude/skills/project/swarm.env — KEY=VALUE lines, $MAIN is the main checkout.
#      SWARM_MAX_WORKERS=<n> there caps the lead's slots.
#   3. <main>/.claude/skills/project/swarm-settings.json — merged into the worker's --settings
#
# launch's stdout: one line, "<bead-id>\t<exit>\t<outfile>\t<worktree>". Diagnostics go to stderr.
# check exits 4 when the repo's project skill has no swarm.md: the lead writes it, then re-checks.
set -eu

D="$HOME/.claude/skills/dispatch/dispatch"
RA_PLUGIN="rust-analyzer-lsp@claude-plugins-official"

die() { echo "swarm: $*" >&2; exit 1; }
need() { command -v "$1" >/dev/null 2>&1 || die "missing '$1'"; }

# The repo's main checkout, from $PWD. A swarm is led from the main checkout, never a worktree.
main_checkout() {
  local gitdir common
  gitdir="$(git -C "$PWD" rev-parse --absolute-git-dir 2>/dev/null)" || die "not in a git repo: $PWD"
  common="$(git -C "$PWD" rev-parse --path-format=absolute --git-common-dir)"
  [ "$gitdir" = "$common" ] || die "run swarm from the repo's main checkout, not a linked worktree"
  git -C "$PWD" rev-parse --show-toplevel
}

# Which multiplexer holds the workers: herdr (a child space per worker) or wheel (a pane per
# worker in the repo's background swarm space). Empty outside both.
surface() {
  if [ "${HERDR_ENV:-}" = "1" ]; then echo herdr
  elif [ "${WHEEL_ENV:-}" = "1" ]; then echo wheel
  fi
}

# The herdr space of the repo's main checkout, or empty. Workers nest under it as child spaces;
# without it herdr-agent puts each one at the top level.
repo_space() { "$HOME/.claude/skills/dispatch/herdr-agent" repo-space "$1"; }

# The background Wheel space a repo's workers run in, by name: one per repo, rooted at its main
# checkout, so removing a worktree never pulls a space out from under the others.
wheel_space() { printf '%s swarm' "$(basename "$1")"; }

# Where wheel-agent records a worker's pane id and state: <worktree git dir>/wheel-agent.
wheel_dir() { printf '%s/wheel-agent' "$(git -C "$(worktree_path "$1" "$2")" rev-parse --absolute-git-dir 2>/dev/null)"; }

# Runtimes the repo builds with, one per line, from tracked marker files up to two levels deep.
# Each name is a skills/ref/<name>/ directory whose swarm.md the worker reads.
runtimes() {
  git -C "$1" ls-files | awk -F/ 'NF <= 3 { print $NF }' | awk '
    $0 == "Cargo.toml"                                        { r["rust"] = 1 }
    $0 == "go.mod"                                            { r["go"] = 1 }
    $0 == "pyproject.toml" || $0 == "requirements.txt"        { r["python"] = 1 }
    $0 == "package.json"                                      { r["web"] = 1 }
    $0 == "Package.swift" || $0 == "project.yml" || /\.pbxproj$/ { r["apple"] = 1 }
    END { for (k in r) print k }' | sort
}

project_skill() { printf '%s/.claude/skills/project' "$1"; }

# selfland (owned) or signoff (collaborative); dies on any other tier.
landing_mode() {
  local tier; tier="$("$HOME/.claude/tools/repo-tier" "$1")"
  case "$tier" in
    owned) echo selfland ;;
    collaborative) echo signoff ;;
    *) die "repo-tier says '$tier' for $1 — a swarm runs only on an owned or collaborative repo" ;;
  esac
}

# <scratch>/swarm for the repo, where outfiles and the run log live.
run_dir() { printf '%s/swarm' "$( cd "$1" && "$HOME/.claude/tools/repo-slug" --path )"; }

# Append "<utc time>\t<event>\t<bead-id>\t<detail>" to the run log.
log_event() {
  local dir; dir="$(run_dir "$1")"; mkdir -p "$dir"
  printf '%s\t%s\t%s\t%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$2" "${3:-}" "${4:-}" >> "$dir/run.tsv"
}

# The Claude config dir a worker's `claude` will run under, resolved the way its launch does:
# the interactive shell in the main checkout (and its profile router, when one is defined), then
# under Wheel the wrapper's `agent.claude.home` setting, which it applies when the shell set none.
profile_dir() {
  local dir
  dir="$( ( cd "$1" && zsh -ic '(( $+functions[_claude_apply_profile] )) && _claude_apply_profile; print -r -- "PROFILE_DIR=${CLAUDE_CONFIG_DIR:-}"' 2>/dev/null ) \
    | sed -n 's/^PROFILE_DIR=//p' | tail -1)"
  if [ -z "$dir" ] && [ -n "${WHEEL_ENV:-}" ]; then
    dir="$(wheel config get agent.claude.home 2>/dev/null)"
  fi
  printf '%s\n' "${dir:-$HOME/.claude}"
}

# Prints "<session%> <weekly%> <age-seconds> <profile-dir>" from the status line's usage cache,
# or exits 1 with the reason when there is no fresh reading.
quota_read() {
  local dir f ts
  dir="$(profile_dir "$1")"; [ -n "$dir" ] || { echo "cannot resolve the Claude profile for $1" >&2; return 1; }
  f="$dir/statusline-cache/usage"
  # The status line owns the fetch (swarm never calls the usage API). While its cache holds an
  # error, such as a 429, gate on the last good reading it kept, subject to the same age limit.
  if [ ! -f "$f" ] || grep -q '^ERROR=' "$f"; then
    [ -f "$f.good" ] || { echo "no usable usage cache at $f ($(sed -n 's/^ERROR=//p' "$f" 2>/dev/null))" >&2; return 1; }
    f="$f.good"
  fi
  ts="$(sed -n 's/^TIMESTAMP=//p' "$f")"
  [ -n "$ts" ] && [ $(( $(date +%s) - ts )) -le 1800 ] || { echo "usage cache at $f is older than 30 minutes" >&2; return 1; }
  printf '%s %s %s %s\n' "$(sed -n 's/^UTILIZATION=//p' "$f")" "$(sed -n 's/^WEEKLY_UTILIZATION=//p' "$f")" \
    "$(( $(date +%s) - ts ))" "$dir"
}

# Exit 0 when a new worker may start; otherwise print why and exit 5. An unreadable quota
# stops launches too: a missing reading is not room to spend.
quota_gate() {
  local r s w age dir
  [ -n "${SWARM_SKIP_QUOTA:-}" ] && { echo "swarm: quota check skipped (SWARM_SKIP_QUOTA)" >&2; return 0; }
  r="$(quota_read "$1")" || { echo "swarm: quota unknown — not launching (SWARM_SKIP_QUOTA=1 skips the check)" >&2; return 5; }
  read -r s w age dir <<<"$r"
  if [ "${s:-0}" -ge "${SWARM_QUOTA_SESSION:-90}" ] || [ "${w:-0}" -ge "${SWARM_QUOTA_WEEKLY:-90}" ]; then
    echo "swarm: quota $dir at ${s}% of the 5-hour window, ${w}% of the week (limits ${SWARM_QUOTA_SESSION:-90}%, ${SWARM_QUOTA_WEEKLY:-90}%) — not launching" >&2
    return 5
  fi
}

# Refuse a launch while the machine's free memory is under the floor: every worker is a whole
# Claude session plus its MCP servers and builds, and other sessions share the same memory.
memory_gate() {
  local floor="${SWARM_MEMORY_FLOOR:-25}" free
  free="$(memory_pressure -Q 2>/dev/null | sed -n 's/.*free percentage: \([0-9]*\)%.*/\1/p')"
  [ -n "$free" ] || { echo "swarm: free memory unknown — not launching" >&2; return 6; }
  if [ "$free" -lt "$floor" ]; then
    echo "swarm: ${free}% of memory free, under the ${floor}% floor — not launching" >&2
    return 6
  fi
  echo "swarm: ${free}% of memory free (floor ${floor}%)" >&2
}

# Where a worker's worktree lives.
worktree_path() { printf '%s/.worktrees/%s/%s\n' "$HOME" "$(basename "$1")" "$2"; }

# Give a rust worktree its own target/, cloned from the main checkout's so dependencies start
# built. A target shared across worktrees hands one worker another's binaries and, when cargo's
# fingerprints miss a source change between worktrees, another's build of a workspace crate.
clone_target() {
  local repo="$1" wt="$2"
  [ -d "$repo/target" ] || return 0
  if [ "$(uname)" = Darwin ]; then cp -c -R "$repo/target" "$wt/target"
  else cp --reflink=auto -R "$repo/target" "$wt/target"; fi \
    || echo "swarm: could not clone $repo/target into $wt — the worker's first build starts cold" >&2
}

# KEY=VALUE lines for a worker's environment.
worker_env() {
  local repo="$1" id="$2" f
  runtimes "$repo" | grep -qx rust && printf 'CARGO_TARGET_DIR=%s/target\n' "$(worktree_path "$repo" "$id")"
  f="$(project_skill "$repo")/swarm.env"
  [ -f "$f" ] && grep -E '^[A-Za-z_][A-Za-z0-9_]*=' "$f" | sed "s#\\\$MAIN#$repo#g"
  return 0
}

# The JSON a worker gets as --settings. The environment travels in its `env` key: herdr's server
# spawns the worker's shell, so nothing exported here reaches it any other way.
worker_settings() {
  local repo="$1" id="$2" base f env
  env="$( { worker_env "$repo" "$id"; printf 'SWARM_WORKER=%s\n' "$id"
            if [ "$(landing_mode "$repo")" = signoff ]; then echo SWARM_SIGNOFF=1; fi; } \
    | jq -Rn '[inputs | capture("^(?<k>[^=]+)=(?<v>.*)$")] | map({(.k): .v}) | add')"
  base="$(jq -cn --argjson env "$env" '{env: $env}')"
  runtimes "$repo" | grep -qx rust && base="$(jq -c --arg p "$RA_PLUGIN" '. * {enabledPlugins: {($p): false}}' <<<"$base")"
  f="$(project_skill "$repo")/swarm-settings.json"
  if [ -f "$f" ]; then jq -c --argjson base "$base" '$base * .' "$f"; else printf '%s\n' "$base"; fi
}

cmd_check() {
  need git; need jq; need bd
  local surf; surf="$(surface)"
  [ -n "$surf" ] || die "not inside herdr or Wheel (HERDR_ENV, WHEEL_ENV) — swarm workers need one to run in"
  need "$surf"
  local repo mode
  repo="$(main_checkout)"
  mode="$(landing_mode "$repo")"
  bd -C "$repo" ready --limit 1 --json >/dev/null 2>&1 || die "bd cannot read the tracker in $repo"
  "$D" check --agent claude >&2
  # Open the repo's herdr space once, here, so parallel launches never race to create it.
  local ws where
  if [ "$surf" = herdr ]; then
    ws="$(repo_space "$repo")"
    if [ -z "$ws" ]; then
      ws="$(herdr workspace create --cwd "$repo" --label "$(basename "$repo")" --no-focus | jq -r '.result.workspace.workspace_id')"
      echo "swarm: opened herdr space $ws for $repo — workers nest under it" >&2
    fi
    where="workers open as child spaces of $ws"
  else
    "$HOME/.claude/tools/wheel-space" >/dev/null || die "inside Wheel but this pane's space cannot be resolved"
    where="workers open as panes in the background Wheel space '$(wheel_space "$repo")', rooted at $repo; it opens with the first worker and closes with the last"
  fi
  local rts; rts="$(runtimes "$repo" | paste -sd' ' -)"
  echo "swarm: runtimes: ${rts:-none detected}" >&2
  local r; for r in $rts; do
    [ -f "$HOME/.claude/skills/ref/$r/swarm.md" ] && echo "swarm:   $HOME/.claude/skills/ref/$r/swarm.md" >&2
  done
  echo "swarm: worker settings: $(worker_settings "$repo" '<bead-id>')" >&2
  if [ ! -f "$(project_skill "$repo")/swarm.md" ]; then
    echo "swarm: no $(project_skill "$repo")/swarm.md — write the project skill's swarm section (the project-skills skill), then check again" >&2
    exit 4
  fi
  local q; q="$(quota_read "$repo")" && echo "swarm: quota (5-hour weekly age dir): $q" >&2
  quota_gate "$repo" || exit 5
  echo "swarm: landing mode: $mode" >&2
  echo "swarm: ready in $repo; $where" >&2
}

cmd_launch() {
  local id="${1:-}" model="${2:-}" reason="" dry=0 resume=0
  [ -n "$id" ] && [ -n "$model" ] || die "usage: swarm launch <bead-id> <haiku|sonnet|opus> [--opus-reason \"<text>\"] [--resume] [--dry-run]"
  shift 2
  while [ $# -gt 0 ]; do
    case "$1" in
      --opus-reason) reason="${2:-}"; shift 2 ;;
      --resume) resume=1; shift ;;
      --dry-run) dry=1; shift ;;
      *) die "unknown flag: $1" ;;
    esac
  done
  case "$model" in haiku|sonnet) ;; opus) [ -n "$reason" ] || die "opus needs --opus-reason" ;; *) die "model must be haiku, sonnet or opus" ;; esac
  [ "$model" = opus ] || [ -z "$reason" ] || die "--opus-reason is only for opus"

  local repo; repo="$(main_checkout)"
  local bead status
  bead="$(bd -C "$repo" show "$id" --json 2>/dev/null)" || die "no bead '$id' in $repo"
  status="$(printf '%s' "$bead" | jq -r 'if type == "array" then .[0] else . end | .status')"
  if [ "$resume" -eq 1 ]; then
    [ "$status" = in_progress ] || die "bead $id is '$status'; --resume picks up a claimed bead"
  else
    [ "$status" = open ] || die "bead $id is '$status', not open"
  fi
  printf '%s' "$bead" | jq -e 'if type == "array" then .[0] else . end | (.labels // []) | index("human")' >/dev/null \
    && die "bead $id is labelled human — it is a question for iron-out, not work"
  [ -f "$(project_skill "$repo")/swarm.md" ] || die "no project skill swarm.md in $repo — run 'swarm check'"

  local base wt branch outdir outfile
  branch="swarm/$id"
  wt="$(worktree_path "$repo" "$id")"
  base="$(git -C "$repo" symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null | sed 's#^origin/##')" || true
  base="${base:-$(git -C "$repo" branch --show-current)}"
  outdir="$(run_dir "$repo")"
  outfile="$outdir/$id.md"

  local mode; mode="$(landing_mode "$repo")"
  local pages="" r
  for r in $(runtimes "$repo"); do
    [ -f "$HOME/.claude/skills/ref/$r/swarm.md" ] && pages="$pages
  - $HOME/.claude/skills/ref/$r/swarm.md"
  done

  local landing outcome
  if [ "$mode" = selfland ]; then
    landing="Land through \`wrap-up\` as auto mode does — this worktree carries a SELF-LAND marker. Never
remove this worktree, push its branch or delete a remote branch: \`land\` pushes your commits
to $base, and the swarm lead tears the worktree down after reading your report."
    outcome="Say in its first line whether the bead landed (with the commit sha on $base) or was parked
(with the reason). The report carries the \`## Cases\` table AUTO.md § A case not driven parks the
item describes, one row per case in the bead; a case you could not drive parks the bead. It also
carries the gate (CHAT-FORMAT.md § Gate): a \`Run:\` line with the commands you ran and a \`Look
for:\` line with the output you saw. The lead rejects a landed report without both."
  else
    landing="This repo is collaborative, so this pass ends at sign-off (AUTO.md § Swarm workers,
SWARM_SIGNOFF=1): run \`wrap-up\` through Phase 5's commit and stop. Push nothing, open no PR,
close no bead, file no follow-up and fix none from the slate — the user signs each of those off
through the lead. Leave the worktree clean, with every change committed on $branch."
    outcome="Say in its first line whether the bead is ready for sign-off or was parked (with the
reason). A ready report carries the gate (CHAT-FORMAT.md § Gate), a \`Run:\` line with the commands
you ran and a \`Look for:\` line with the output you saw; the lead rejects it without both. It also
carries a section headed exactly \`## Sign-off package\` with:
  - Branch: \`<type>/<descriptive-name>\` to push as — no bead id anywhere in it
  - PR title: Conventional Commits, no bead id
  - PR body: wrap-up's PR body format, no bead id
  - Follow-ups: every candidate wrap-up Phase 6 Step A would have shown, one line each with its
    proposed disposition [fix], [file] or [skip] and the file:line it refers to"
  fi
  local brief
  brief="Call \`Skill(implement)\` first, then run \`implement $id auto\` in this worktree.
The swarm lead claimed $id for you, so it reads \`in_progress\` (AUTO.md § Swarm workers).

This is one worker in a swarm. Nobody is watching this pane: take every decision the way auto
mode says, record it as an \`auto decided\` note on the bead, and park the bead rather than wait.
$landing

The swarm artifact shows each worker's stage from the work board. As each implement step
starts (plan, edit, build, verify, review, gate), call the \`work_set\` tool with
\`{kind: \"bead\", id: \"$id\", stage: <the step>, note: <one line: what you are doing>}\`.

Files under \`.claude/\` that are symlinks (check with \`ls -la\`) belong to the main checkout and
are shared by every worker — the \`project\` skill and other local skills usually are. Never edit
one. When your pass would extend it, put the change in your report under a heading
\`## Shared-file changes\`: the file's main-checkout path and the exact text to add or replace.
The lead applies it after your bead lands.

Other workers are building and testing this repo on the same machine right now. Before your
first build or test, read:
  - $(project_skill "$repo")/swarm.md — this project's swarm rules; they win over the pages below${pages}

Run every build, test, lint or other CPU-heavy command through the swarm's lock, so workers
take turns instead of starving each other:

  \"\$HOME/.claude/skills/swarm/swarm\" heavy -- <command>

It waits while another worker holds the lock and says who. Batch your heavy work — one build
and test run per round of edits, not one per file. Your environment already carries the
project's shared build settings; do not override them.

Model: $model.${reason:+
Opus reason: $reason}

Mode: report-back. Also write your report, the same text, to \`$outfile\`; the swarm lead reads
it. $outcome"
  [ "$resume" -eq 1 ] && brief="$brief

Resumed: an earlier worker on $id stopped before finishing (its session ended with the
machine). Its uncommitted changes and any commits on $branch are still in this worktree. Read
\`git status\` and \`git diff\` first, keep what fits the bead, and carry on from there."

  local settings; settings="$(worker_settings "$repo" "$id")"
  if [ "$dry" -eq 1 ]; then
    echo "swarm: dry run — would create $wt on branch $branch from $base, outfile $outfile, landing mode $mode" >&2
    echo "swarm: settings: $settings" >&2
    quota_gate "$repo" && echo "swarm: quota allows a launch" >&2
    memory_gate || true
    printf '%s\n' "$brief"
    return 0
  fi

  quota_gate "$repo" || exit 5
  memory_gate || exit 6
  local surf; surf="$(surface)"
  [ -n "$surf" ] || die "not inside herdr or Wheel — run 'swarm check'"
  [ "$surf" != herdr ] || [ -n "$(repo_space "$repo")" ] || die "no herdr space open for $repo — run 'swarm check' first so workers nest under it"
  if [ "$resume" -eq 1 ]; then
    [ "$(git -C "$wt" branch --show-current 2>/dev/null)" = "$branch" ] || die "--resume needs $wt on branch $branch"
    mkdir -p "$outdir"
    [ -d "$wt/target" ] || ! runtimes "$repo" | grep -qx rust || clone_target "$repo" "$wt"
  else
    [ -e "$wt" ] && die "worktree path already exists: $wt — a previous launch of $id left it; land it, remove it, or pass --resume"
    git -C "$repo" show-ref --verify --quiet "refs/heads/$branch" && die "branch $branch already exists"
    bd -C "$repo" update "$id" --claim >/dev/null || die "could not claim $id"
    mkdir -p "$outdir" "$(dirname "$wt")"
    # Workers start from the remote's tip: the main checkout's local branch can sit behind it,
    # and a worker cut from there lacks every bead landed since.
    local start="$base"
    git -C "$repo" fetch -q origin "$base" >&2 && start="origin/$base"
    git -C "$repo" worktree add -q -b "$branch" "$wt" "$start" >&2 || {
      bd -C "$repo" update "$id" --status open --assignee "" >/dev/null 2>&1
      die "could not create $wt — released the claim on $id"; }
    CLAUDE_PROJECT_DIR="$wt" bash "$HOME/.claude/hooks/worktree-link-locals.sh" >&2 || true
    runtimes "$repo" | grep -qx rust && clone_target "$repo" "$wt"
  fi
  local gd; gd="$(git -C "$wt" rev-parse --absolute-git-dir)"
  [ "$mode" = selfland ] && touch "$gd/SELF-LAND"
  printf '%s\n' "$brief" > "$gd/DISPATCH-BRIEF.md"
  printf '%s\n' "$settings" > "$gd/swarm-settings.json"
  echo "swarm: $id ($model) in $wt" >&2
  log_event "$repo" launched "$id" "$model $wt"

  # The worker's space is labelled with the bead and its title, so the sidebar says what each does.
  local name title
  title="$(bd -C "$repo" show "$id" --json 2>/dev/null | jq -r 'if type == "array" then .[0].title else .title end // empty' 2>/dev/null)"
  name="$id${title:+ $title}"
  local rc=0
  (
    cd "$wt"
    # An implement pass routinely outlasts dispatch's 40-minute ceiling.
    export CLAUDE_DISPATCH_SETTINGS="$gd/swarm-settings.json" HERDR_AGENT_TIMEOUT_MS=14400000 \
           WHEEL_AGENT_TIMEOUT_MS=14400000 WHEEL_AGENT_DIR="$gd/wheel-agent" DISPATCH_TRANSPORT="$surf" \
           WHEEL_AGENT_SPACE="$(wheel_space "$repo")" WHEEL_AGENT_SPACE_DIR="$repo"
    exec "$D" exec --agent "claude:$model" --name "$name" "$gd/DISPATCH-BRIEF.md" "$outfile"
  ) >&2 || rc=$?
  log_event "$repo" finished "$id" "exit $rc"
  printf '%s\t%s\t%s\t%s\n' "$id" "$rc" "$outfile" "$wt"
  return "$rc"
}

cmd_heavy() {
  [ "${1:-}" = "--" ] && shift
  [ $# -gt 0 ] || die "usage: swarm heavy -- <command> [<arg>...]"
  local common lock holder
  common="$(git -C "$PWD" rev-parse --path-format=absolute --git-common-dir 2>/dev/null)" || die "not in a git repo: $PWD"
  lock="$common/swarm-heavy.lock"; holder="$common/swarm-heavy.holder"
  # -k on every call: unlinking the lock file while another process waits on it would let
  # a third take a fresh lock beside it.
  if ! lockf -k -s -t 0 "$lock" true; then
    echo "swarm: waiting for the heavy lock, held by $(cat "$holder" 2>/dev/null || echo 'an unknown process')" >&2
  fi
  local rc=0
  lockf -k -s -t 3600 "$lock" /bin/sh -c '
    printf "%s since %s: %s\n" "${SWARM_WORKER:-$(basename "$PWD")}" "$(date -u +%H:%M:%SZ)" "$*" > "$0"
    exec "$@"' "$holder" "$@" || rc=$?
  [ "$rc" -eq 75 ] && echo "swarm: exit 75 — either an hour passed without the heavy lock, or the command itself exited 75" >&2
  return "$rc"
}

cmd_quota() {
  local repo r s w age dir; repo="$(main_checkout)"
  r="$(quota_read "$repo")" || exit 1
  read -r s w age dir <<<"$r"
  printf '5-hour %s%%\tweekly %s%%\treading %ss old\t%s\n' "$s" "$w" "$age" "$dir"
  quota_gate "$repo" || exit 5
}

# The pid of the Claude session leading the run: the nearest ancestor whose command is claude.
# SWARM_LEAD_PID overrides it. Empty when no ancestor is one.
lead_pid() {
  [ -z "${SWARM_LEAD_PID:-}" ] || { printf '%s' "$SWARM_LEAD_PID"; return; }
  local p=$PPID comm
  while [ "${p:-0}" -gt 1 ]; do
    comm="$(ps -o comm= -p "$p" 2>/dev/null | sed 's#.*/##')" || break
    case "$comm" in claude|claude-*) printf '%s' "$p"; return ;; esac
    p="$(ps -o ppid= -p "$p" 2>/dev/null | tr -d ' ')" || break
  done
}

cmd_log() {
  local repo detail="${3:-}"; repo="$(main_checkout)"
  case "${1:-}" in
    run|lead|filed|landed|reopened|parked|failed|ready|rejected|signed|declined|applied|end) ;;
    *) die "usage: swarm log <run|lead|filed|landed|reopened|parked|failed|ready|rejected|signed|declined|applied|end> [<bead-id>] [<detail>]" ;;
  esac
  if [ "$1" = landed ] || [ "$1" = ready ]; then
    # A report counts only when it carries the gate's Run: and Look for: lines; a refusal is logged.
    local gid="${2:-}" gout gmsg
    [ -n "$gid" ] || die "usage: swarm log $1 <bead-id> <detail>"
    gout="$(run_dir "$repo")/$gid.md"
    [ -s "$gout" ] || die "no report at $gout: log it failed"
    if ! gmsg="$(python3 "$(dirname "$0")/gate-check" "$gout")"; then
      log_event "$repo" rejected "$gid" "$gmsg"
      echo "$gmsg" >&2
      die "$gid is not accepted: send the report back to the worker to add the gate's Run: and Look for: lines"
    fi
  fi
  if [ "$1" = landed ]; then
    # A landing counts only when the worker's report drove every case the bead lists.
    local id="${2:-}" out bead
    [ -n "$id" ] || die "usage: swarm log landed <bead-id> <sha>"
    out="$(run_dir "$repo")/$id.md"
    [ -s "$out" ] || die "no report at $out, so nothing shows the cases were driven: log it failed"
    bead="$(mktemp)"
    ( cd "$repo" && bd show "$id" --json ) > "$bead" || { rm -f "$bead"; die "bd show $id failed"; }
    if ! python3 "$(dirname "$0")/cases-check" "$bead" "$out" >&2; then
      rm -f "$bead"
      die "$id is not landed: reopen it (bd update $id --status open --append-notes \"not verified: <cases>\") and log it with swarm log reopened $id \"not verified: <cases>\""
    fi
    rm -f "$bead"
  fi
  if [ "$1" = run ]; then
    local pid; pid="$(lead_pid)"
    detail="${detail:+$detail }${pid:+pid=$pid }space=$(basename "$repo" | tr -s ' ' _)"
  fi
  if [ "$1" = lead ] && ! printf '%s' "$detail" | grep -q 'pid='; then
    local lpid; lpid="$(lead_pid)"
    detail="${detail:+$detail }${lpid:+pid=$lpid}"
  fi
  log_event "$repo" "$1" "${2:-}" "$detail"
}

# The run log, then one line per bead launched in the latest run with no `finished` yet.
cmd_status() {
  local repo f; repo="$(main_checkout)"; f="$(run_dir "$repo")/run.tsv"
  [ -f "$f" ] || { echo "swarm: no run log at $f" >&2; exit 1; }
  local start; start="$(awk -F'\t' '$2 == "run" { n = NR } END { print n + 0 }' "$f")"
  awk -F'\t' -v s="$start" 'NR >= s' "$f"
  echo "--- in flight"
  awk -F'\t' -v s="$start" 'NR >= s && $2 == "launched" { l[$3] = $4 } NR >= s && $2 == "finished" { delete l[$3] }
    END { for (k in l) print k "\t" l[k] }' "$f" | while IFS="$(printf '\t')" read -r id detail; do
      printf '%s\t%s\tagent %s\n' "$id" "$detail" "$(worker_state "$repo" "$id")"
    done
  echo "--- sign-off inbox (oldest first)"
  awk -F'\t' -v s="$start" 'NR >= s && $2 == "ready" { o[++n] = $3; d[$3] = $1 "\t" $4 }
    NR >= s && ($2 == "signed" || $2 == "declined") { delete d[$3] }
    END { for (i = 1; i <= n; i++) if (o[i] in d) { print o[i] "\t" d[o[i]]; delete d[o[i]] } }' "$f"
}

# A launched worker's agent state: herdr's for its space, or wheel-agent's state file while
# its pane is still open. "no space" / "no pane" means the worker is gone.
worker_state() {
  local repo="$1" id="$2" d p
  case "$(surface)" in
    herdr) herdr workspace list 2>/dev/null | jq -r --arg l "$id" '[.result.workspaces[] | select(.label == $l) | .agent_status][0] // "no space"' ;;
    wheel)
      d="$(wheel_dir "$repo" "$id")"; p="$(cat "$d/pane" 2>/dev/null || true)"
      if [ -n "$p" ] && wheel pane ls --json 2>/dev/null | jq -e --arg p "$p" 'any(.[]; .pane == $p)' >/dev/null; then
        printf '%s (pane %s)' "$(cat "$d/state" 2>/dev/null || echo starting)" "$p"
      else echo "no pane"; fi ;;
    *) echo "unknown (not inside herdr or Wheel)" ;;
  esac
}

# Close a finished worker's surface. landed: also remove its worktree (git-sweep reaps any left).
# parked: keep the worktree and branch for the user.
cmd_close() {
  local id="${1:-}" how="${2:-}" repo wt ws p
  case "$how" in landed|parked) ;; *) die "usage: swarm close <bead-id> landed|parked" ;; esac
  repo="$(main_checkout)"; wt="$(worktree_path "$repo" "$id")"
  case "$(surface)" in
    herdr)
      ws="$(herdr workspace list | jq -r --arg w "$wt" '[.result.workspaces[] | select(.cwd == $w) | .workspace_id][0] // empty')"
      [ -n "$ws" ] || die "no herdr space open on $wt"
      if [ "$how" = landed ]; then herdr worktree remove --workspace "$ws" --force
      else herdr workspace close "$ws"; fi ;;
    wheel)
      p="$(cat "$(wheel_dir "$repo" "$id")/pane" 2>/dev/null || true)"
      [ -n "$p" ] && wheel pane close "$p" >/dev/null 2>&1 && echo "swarm: closed pane $p" >&2
      [ "$how" = landed ] && [ -d "$wt" ] && git -C "$repo" worktree remove --force "$wt" && echo "swarm: removed $wt" >&2
      return 0 ;;
    *) die "not inside herdr or Wheel" ;;
  esac
}

case "${1:-}" in
  check)  shift; cmd_check ;;
  close)  shift; cmd_close "$@" ;;
  launch) shift; cmd_launch "$@" ;;
  heavy)  shift; cmd_heavy "$@" ;;
  quota)  shift; cmd_quota ;;
  log)    shift; cmd_log "$@" ;;
  status) shift; cmd_status ;;
  *) echo "usage: swarm check | close <bead-id> landed|parked | launch <bead-id> <haiku|sonnet|opus> [--opus-reason \"<text>\"] [--dry-run] | heavy -- <command> | quota | log <event> [<bead-id>] [<detail>] | status" >&2; exit 2 ;;
esac

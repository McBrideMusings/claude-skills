#!/usr/bin/env python3
"""spike-export — hand a prototype to someone, or to your own phone.

Writes a self-contained directory holding:

  index.html      the prototype, with its Tweaks panel
  serve.command   double-clickable on macOS: opens Terminal, starts a LAN web
                  server, and prints the URL to type into the phone
  RUN.bat         the same on Windows, using PowerShell and .NET, which ship with
                  the OS — nothing to download and nothing to install
  README.md       what the folder is and how to open it
"""
import argparse
import datetime
import os
import shutil
import stat
import subprocess
import sys

TOOL = os.path.join(os.path.dirname(os.path.abspath(__file__)), "spike")

README = """# __TITLE__

A throwaway prototype. It exists to answer a question about how something should
look or feel, not to be correct, complete, or shipped. Nothing here is production
code and none of it is wired to a real backend — every value on screen is fixed
sample content.

Exported __DATE__.

## What is in this folder

| File | What it is |
| --- | --- |
| `index.html` | The prototype. Double-click it. It is one file with no internet, no install and no assets alongside it: you can email it, drop it in Slack, or open it on a plane. |
| `serve.command` | **Mac:** double-click to put this on your local network so a phone can open it. |
| `RUN.bat` | **Windows:** the same. |

## Looking at it on a phone

1. Double-click **`serve.command`** (Mac) or **`RUN.bat`** (Windows).
2. It prints two addresses. Type the `http://192.168.…` one into your phone's browser.
3. Your phone and this computer must be on the **same Wi-Fi**.
4. Leave that window open while you use it. Close it to stop.

Neither launcher installs anything. On Windows the first run may show *"Windows
protected your PC"* — click **More info → Run anyway**. That is Windows being
cautious about a file that came from somewhere else.

Both pick their own free port and print it. To force one:
`PORT=8850 ./serve.command`, or `set PORT=8850` before `RUN.bat`.

## The controls card

The floating **Tweaks** card holds the variant chooser and every parameter this
prototype exposes. The `×` shrinks it to a pill in the corner, and the pill opens it
again. Add `?tweaks=0` to the address to open with it already shrunk.

The address bar remembers only what you actually change. An untouched control is
absent from the URL, so a link you send carries your changes and nothing else.

## Reporting something

Say what you did, what you expected, and what happened. A screen recording beats a
description. If it was a specific control, the URL from the address bar pins the
exact state you were looking at.
"""

SERVE = """#!/bin/bash
# Double-click me. Serves this folder so a phone on the same Wi-Fi can load the
# prototype. Close the window or press Ctrl-C to stop.
#
# No dependencies. python3 on a clean macOS is a Command Line Tools stub that
# prompts instead of running, so it is probed rather than assumed; ruby is
# deprecated and may be gone; /usr/bin/nc ships on every macOS and is the floor.
cd "$(dirname "$0")" || exit 1
clear

# NOT 8080. Every dev server on a Mac wants that port, and python's http.server sets
# SO_REUSEADDR — so binding 0.0.0.0:8080 SUCCEEDS while another process already owns
# 127.0.0.1:8080. It prints "Serving HTTP", and the browser reaches that other app.
# The symptom is someone else's login page where the prototype should be, with a
# server that says it started. So: refuse any port something already answers on.
taken() { /usr/bin/nc -z -G 1 127.0.0.1 "$1" >/dev/null 2>&1; }

if [ -n "$PORT" ]; then
  if taken "$PORT"; then
    printf '\\n  Port %s is already in use by something else. Pick another:\\n' "$PORT"
    printf '      PORT=8795 ./serve.command\\n\\n'
    exit 1
  fi
else
  for p in 8791 8792 8793 8794 8795 8796 8797 8798 8799; do
    if ! taken "$p"; then PORT="$p"; break; fi
  done
  if [ -z "$PORT" ]; then
    printf '\\n  Every port from 8791 to 8799 is in use. Free one, or set PORT.\\n\\n'
    exit 1
  fi
fi

IP="$(ipconfig getifaddr en0 2>/dev/null \\
   || ipconfig getifaddr en1 2>/dev/null \\
   || echo 127.0.0.1)"

printf '\\n  %s\\n\\n' "__TITLE__"
printf '  On this Mac        http://localhost:%s/\\n' "$PORT"
printf '  On your phone      http://%s:%s/\\n\\n' "$IP" "$PORT"
printf '  Both devices must be on the same Wi-Fi.\\n'
printf '  Leave this window open. Ctrl-C to stop.\\n\\n'

if python3 -c '' >/dev/null 2>&1; then
  echo "  [serving with python3]"
  exec python3 -m http.server "$PORT" --bind 0.0.0.0
fi

if ruby -e '' >/dev/null 2>&1; then
  echo "  [serving with ruby]"
  exec ruby -run -e httpd . -p "$PORT" -b 0.0.0.0
fi

# Floor: one file, one connection at a time, using only /usr/bin/nc. It cannot route,
# so it answers every path with index.html, which is the only file there is.
echo "  [serving with nc]"
LEN="$(wc -c < index.html | tr -d ' ')"
while :; do
  {
    printf 'HTTP/1.1 200 OK\\r\\n'
    printf 'Content-Type: text/html; charset=utf-8\\r\\n'
    printf 'Content-Length: %s\\r\\n' "$LEN"
    printf 'Cache-Control: no-store\\r\\n'
    printf 'Connection: close\\r\\n\\r\\n'
    cat index.html
  } | nc -l "$PORT" >/dev/null 2>&1 || sleep 1
done
"""


# A .bat, because it is the only thing on Windows that runs when double-clicked. The
# server is System.Net.HttpListener driven by PowerShell 5.1 — both ship with every
# Windows 10 and 11, so there is nothing to download and nothing to install. The whole
# PowerShell program lives after the #POWERSHELL# marker in this same file and is read
# back off its own path, so there is one file to hand over.
#
# Two things in it are load-bearing and look odd:
#   - the marker is built from [char]35 rather than written literally, so the command
#     line does not plant a second copy of it ABOVE the real one for IndexOf to find.
#   - the file is written with CRLF. cmd.exe mishandles a .bat with bare LF endings.
WINDOWS_BAT = """@echo off
setlocal
set "SPIKE_ROOT=%~dp0"
set "SPIKE_TITLE=__TITLE__"
powershell -NoProfile -ExecutionPolicy Bypass -Command "$c=[IO.File]::ReadAllText('%~f0'); $i=$c.IndexOf([char]35+'POWERSHELL'+[char]35); Invoke-Expression $c.Substring($i+13)"
if errorlevel 1 (
  echo.
  echo   It did not start. Send whatever is printed above to whoever gave you this.
  echo.
  pause
)
endlocal
exit /b
#POWERSHELL#
$ErrorActionPreference = 'Stop'
$root  = (Resolve-Path $env:SPIKE_ROOT).Path.TrimEnd('\\')
$title = $env:SPIKE_TITLE

$mime = @{
  '.html'='text/html; charset=utf-8'; '.htm'='text/html; charset=utf-8';
  '.js'='application/javascript'; '.css'='text/css'; '.json'='application/json';
  '.png'='image/png'; '.jpg'='image/jpeg'; '.jpeg'='image/jpeg';
  '.gif'='image/gif'; '.svg'='image/svg+xml'; '.webp'='image/webp';
  '.glb'='model/gltf-binary'; '.gltf'='model/gltf+json';
  '.txt'='text/plain; charset=utf-8'; '.md'='text/plain; charset=utf-8';
  '.woff'='font/woff'; '.woff2'='font/woff2'; '.ico'='image/x-icon'
}

if (-not (Test-Path (Join-Path $root 'index.html'))) {
  Write-Host ''
  Write-Host '  index.html is missing. Unzip the WHOLE folder and run this from inside it.'
  Write-Host ''
  Read-Host '  Press Enter to close'
  exit 1
}

function Test-PortFree([int]$p) {
  try {
    $t = New-Object System.Net.Sockets.TcpListener([System.Net.IPAddress]::Loopback, $p)
    $t.Start(); $t.Stop(); return $true
  } catch { return $false }
}

$port = 0
if ($env:PORT) {
  if (Test-PortFree ([int]$env:PORT)) { $port = [int]$env:PORT }
  else { Write-Host ''; Write-Host "  Port $env:PORT is already in use."; Write-Host ''; Read-Host '  Press Enter to close'; exit 1 }
} else {
  foreach ($p in 8791..8799) { if (Test-PortFree $p) { $port = $p; break } }
}
if ($port -eq 0) {
  Write-Host ''; Write-Host '  Every port from 8791 to 8799 is in use.'; Write-Host ''
  Read-Host '  Press Enter to close'; exit 1
}

# http://+:port/ reaches the phone but Windows reserves it for administrators.
# Try it, and drop to localhost-only rather than demanding elevation — looking
# at it on this PC is the common case and must never need a UAC prompt.
$listener = New-Object System.Net.HttpListener
$lan = $true
try {
  $listener.Prefixes.Add("http://+:$port/")
  $listener.Start()
} catch {
  $lan = $false
  $listener = New-Object System.Net.HttpListener
  $listener.Prefixes.Add("http://localhost:$port/")
  try { $listener.Start() } catch {
    Write-Host ''; Write-Host "  Could not open port $port : $($_.Exception.Message)"; Write-Host ''
    Read-Host '  Press Enter to close'; exit 1
  }
}

$url = "http://localhost:$port/"
Clear-Host
Write-Host ''
Write-Host "  $title"
Write-Host ''
Write-Host "  On this PC:   $url"
if ($lan) {
  # Get-NetIPAddress is a Windows cmdlet. Not being able to list the addresses
  # must never take the server down with it — the PC URL above still works.
  try {
    foreach ($ip in (Get-NetIPAddress -AddressFamily IPv4 -ErrorAction SilentlyContinue |
                     Where-Object { $_.IPAddress -notmatch '^(127\\.|169\\.254\\.)' })) {
      Write-Host "  On a phone:   http://$($ip.IPAddress):$port/   (same Wi-Fi)"
    }
  } catch {
    Write-Host '  On a phone:   use this PC''s IP address with the port above'
  }
} else {
  Write-Host '  On a phone:   run this as administrator (right-click > Run as administrator)'
}
Write-Host ''
Write-Host '  Close this window to stop.'
Write-Host ''
Start-Process $url

try {
  while ($listener.IsListening) {
    $ctx = $listener.GetContext()
    $req = $ctx.Request; $res = $ctx.Response
    try {
      $rel = [Uri]::UnescapeDataString($req.Url.AbsolutePath).TrimStart('/')
      if ($rel -eq '') { $rel = 'index.html' }
      $rel = $rel.Replace('/', '\\')
      $full = [IO.Path]::GetFullPath((Join-Path $root $rel))

      # Nothing outside this folder, ever.
      if (-not $full.StartsWith($root, [StringComparison]::OrdinalIgnoreCase) -or
          -not (Test-Path $full -PathType Leaf)) {
        $res.StatusCode = 404
        $res.ContentLength64 = 0
      } else {
        $ext = [IO.Path]::GetExtension($full).ToLower()
        $res.ContentType = $(if ($mime.ContainsKey($ext)) { $mime[$ext] } else { 'application/octet-stream' })
        $res.Headers.Add('Cache-Control', 'no-store')
        $bytes = [IO.File]::ReadAllBytes($full)
        $res.ContentLength64 = $bytes.Length
        # A page may HEAD-probe a file before fetching it, so HEAD has to answer
        # with the headers and an empty body rather than 404.
        if ($req.HttpMethod -ne 'HEAD') { $res.OutputStream.Write($bytes, 0, $bytes.Length) }
      }
    } catch {
      $res.StatusCode = 500
    } finally {
      try { $res.OutputStream.Close() } catch {}
    }
  }
} finally {
  try { $listener.Stop() } catch {}
}
"""

def build(fragment, out, title, subtitle):
    cmd = [TOOL, "build", "--kind", "prototype", "--title", title,
           "--fragment", fragment, "--out", out]
    if subtitle:
        cmd += ["--subtitle", subtitle]
    proc = subprocess.run(cmd, capture_output=True, text=True)
    if proc.returncode != 0:
        sys.stderr.write(proc.stdout + proc.stderr)
        sys.exit(proc.returncode)
    return proc.stdout.strip().splitlines()[-1]


def main():
    ap = argparse.ArgumentParser(description="Export a prototype as a folder you can hand over.")
    ap.add_argument("--fragment", required=True, help="absolute path to the body fragment")
    ap.add_argument("--slug", required=True, help="kebab-case name; becomes the folder name")
    ap.add_argument("--title", required=True)
    ap.add_argument("--subtitle", default="", help="one line under the Tweaks card title")
    ap.add_argument("--dest", default=os.path.expanduser("~/Desktop"),
                    help="where to write the folder (default: ~/Desktop)")
    args = ap.parse_args()

    fragment = os.path.abspath(os.path.expanduser(args.fragment))
    if not os.path.isfile(fragment):
        sys.exit("spike-export: no such fragment: " + fragment)

    dest = os.path.join(os.path.abspath(os.path.expanduser(args.dest)), args.slug)
    if os.path.isdir(dest):
        shutil.rmtree(dest)
    os.makedirs(dest)

    index = os.path.join(dest, "index.html")
    build(fragment, index, args.title, args.subtitle)

    with open(os.path.join(dest, "README.md"), "w", encoding="utf-8") as fh:
        fh.write(README
                 .replace("__TITLE__", args.title)
                 .replace("__DATE__", datetime.date.today().isoformat()))

    script = os.path.join(dest, "serve.command")
    with open(script, "w", encoding="utf-8") as fh:
        fh.write(SERVE.replace("__TITLE__", args.title))
    os.chmod(script, os.stat(script).st_mode | stat.S_IXUSR | stat.S_IXGRP | stat.S_IXOTH)

    # CRLF: cmd.exe mishandles a .bat with bare LF line endings.
    winbat = os.path.join(dest, "RUN.bat")
    with open(winbat, "w", encoding="utf-8", newline="\r\n") as fh:
        fh.write(WINDOWS_BAT.replace("__TITLE__", args.title))

    def kb(p):
        return "%.0f KB" % (os.path.getsize(p) / 1024)

    print(dest)
    print("  %-14s %s   the prototype — open on this Mac" % ("index.html", kb(index)))
    print("  %-14s %s   macOS: double-click to serve on the LAN" % ("serve.command", kb(script)))
    print("  %-14s %s   Windows: same, needs nothing installed" % ("RUN.bat", kb(winbat)))
    print("  %-14s %s   what it is and how to use it" % ("README.md", kb(os.path.join(dest, "README.md"))))


if __name__ == "__main__":
    main()

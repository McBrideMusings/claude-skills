#!/usr/bin/env python3
"""spike-export — hand a prototype to someone, or to your own phone.

Writes a self-contained directory holding three things:

  <slug>.html     the device-framed build, for looking at on this Mac
  index.html      the same prototype with no device frame and no Tweaks panel,
                  so a phone renders it as the real interface
  serve.command   double-clickable on macOS: opens Terminal, starts a LAN web
                  server, and prints the URL to type into the phone

The bare build is the point. A phone showing a phone frame inside a phone is
useless for judging whether a design works in the hand, and the Tweaks panel
covers the thing being judged.
"""
import argparse
import datetime
import os
import shutil
import stat
import subprocess
import sys
import tempfile

TOOL = os.path.join(os.path.dirname(os.path.abspath(__file__)), "spike")

# The panel is generated from the fragment's atTweaks registrations, so it is
# not one of the --without widgets. Hiding it is the supported escape hatch.
HIDE_PANEL = """
.at-twk, .at-twk-pill { display: none !important; }
"""

README = """# __TITLE__

A throwaway prototype. It exists to answer a question about how something should
look or feel, not to be correct, complete, or shipped. Nothing here is production
code and none of it is wired to a real backend — every value on screen is fixed
sample content.

Exported __DATE__ for the __DEVICE__ frame.

## What is in this folder

| File | What it is |
| --- | --- |
| `__SLUG__.html` | The framed build. Double-click it. Opens in your browser and draws the __DEVICE__ frame around the design, so you are judging it at the right size. |
| `index.html` | The same prototype with **no frame and no controls panel** — just the interface. This is what a phone should load. Opening it directly on a desktop shows it at whatever size the window happens to be. |
| `serve.command` | Double-click to put `index.html` on your local network so a phone can open it. |

Both HTML files are self-contained: no internet, no install, no assets alongside
them. You can email one, drop it in Slack, or open it on a plane.

## Looking at it on a phone

1. Double-click **`serve.command`**. A Terminal window opens.
2. It prints two addresses. Type the `http://192.168.…` one into your phone's browser.
3. Your phone and this Mac must be on the **same Wi-Fi**.
4. Leave the Terminal window open while you use it. Close it, or press `Ctrl-C`, to stop.

If port 8080 is taken, run it from Terminal as `PORT=9000 ./serve.command`.

The server needs nothing installed. It uses whichever of `python3`, `ruby` or
`nc` your Mac has, and prints which one it picked.

## Using the framed build

The floating card is the control panel. Drag it by its header; the `×` shrinks it
to a pill in the corner, and the pill opens it again.

- **Tweaks** — the variant picker plus every parameter this prototype exposes.
- **Checks** — standing pass/fail checks (contrast, tap targets, overflow, and so on).
- **Comments** — opening this tab turns on the markup layer. Click anything to leave
  a note, then press **Copy comments** and paste the result back to whoever sent you
  this; it comes out as markdown with the prototype's name at the top.

The address bar remembers only what you actually change. An untouched control is
absent from the URL, so a link you send carries your changes and nothing else, and
a rebuilt prototype's new defaults still reach you.

## Reporting something

Say what you did, what you expected, and what happened. A screen recording beats a
description. If it was a specific control, the URL from the address bar pins the
exact state you were looking at.
"""

SERVE = """#!/bin/bash
# Double-click me. Serves this folder so a phone on the same Wi-Fi can load the
# prototype. Close the window or press Ctrl-C to stop.
#
# No dependencies. python3 on a clean macOS is a Command Line Tools stub that
# prompts instead of running, so it is probed rather than assumed; ruby is
# deprecated and may be gone; /usr/bin/nc ships on every macOS and is the floor.
cd "$(dirname "$0")" || exit 1
PORT="${PORT:-8080}"
IP="$(ipconfig getifaddr en0 2>/dev/null \\
   || ipconfig getifaddr en1 2>/dev/null \\
   || echo 127.0.0.1)"

printf '\\n  %s\\n\\n' "__TITLE__"
printf '  On this Mac        http://localhost:%s/\\n' "$PORT"
printf '  On your phone      http://%s:%s/\\n\\n' "$IP" "$PORT"
printf '  Both devices must be on the same Wi-Fi.\\n'
printf '  Leave this window open. Ctrl-C to stop.\\n\\n'

if python3 -c '' >/dev/null 2>&1; then
  echo "  [serving with python3]"
  exec python3 -m http.server "$PORT" --bind 0.0.0.0
fi

if ruby -e '' >/dev/null 2>&1; then
  echo "  [serving with ruby]"
  exec ruby -run -e httpd . -p "$PORT" -b 0.0.0.0
fi

# Floor: one file, one connection at a time, using only /usr/bin/nc. The page is
# hermetic, so answering every path with index.html is a complete server.
echo "  [serving with nc]"
LEN="$(wc -c < index.html | tr -d ' ')"
while :; do
  {
    printf 'HTTP/1.1 200 OK\\r\\n'
    printf 'Content-Type: text/html; charset=utf-8\\r\\n'
    printf 'Content-Length: %s\\r\\n' "$LEN"
    printf 'Cache-Control: no-store\\r\\n'
    printf 'Connection: close\\r\\n\\r\\n'
    cat index.html
  } | nc -l "$PORT" >/dev/null 2>&1 || sleep 1
done
"""


def build(fragment, out, title, extra):
    cmd = [TOOL, "build", "--kind", "prototype", "--title", title,
           "--fragment", fragment, "--out", out] + extra
    proc = subprocess.run(cmd, capture_output=True, text=True)
    if proc.returncode != 0:
        sys.stderr.write(proc.stdout + proc.stderr)
        sys.exit(proc.returncode)
    return proc.stdout.strip().splitlines()[-1]


def main():
    ap = argparse.ArgumentParser(description="Export a prototype as a folder you can hand over.")
    ap.add_argument("--fragment", required=True, help="absolute path to the body fragment")
    ap.add_argument("--slug", required=True, help="kebab-case name; becomes the folder name")
    ap.add_argument("--title", required=True)
    ap.add_argument("--device", required=True,
                    help="device for the framed copy: phone|tablet|desktop|panel|web|tv|fill")
    ap.add_argument("--dest", default=os.path.expanduser("~/Desktop"),
                    help="where to write the folder (default: ~/Desktop)")
    ap.add_argument("--picker", default="switch", choices=["switch", "list"])
    args = ap.parse_args()

    fragment = os.path.abspath(os.path.expanduser(args.fragment))
    if not os.path.isfile(fragment):
        sys.exit("spike-export: no such fragment: " + fragment)

    dest = os.path.join(os.path.abspath(os.path.expanduser(args.dest)), args.slug)
    if os.path.isdir(dest):
        shutil.rmtree(dest)
    os.makedirs(dest)

    framed = os.path.join(dest, args.slug + ".html")
    build(fragment, framed, args.title,
          ["--device", args.device, "--picker", args.picker])

    with tempfile.TemporaryDirectory() as tmp:
        css = os.path.join(tmp, "bare.css")
        with open(css, "w", encoding="utf-8") as fh:
            fh.write(HIDE_PANEL)
        bare = os.path.join(dest, "index.html")
        build(fragment, bare, args.title,
              ["--picker", args.picker, "--extra-css", css,
               "--without", "viewport,checks,annotate,contrast"])

    with open(os.path.join(dest, "README.md"), "w", encoding="utf-8") as fh:
        fh.write(README
                 .replace("__TITLE__", args.title)
                 .replace("__SLUG__", args.slug)
                 .replace("__DEVICE__", args.device)
                 .replace("__DATE__", datetime.date.today().isoformat()))

    script = os.path.join(dest, "serve.command")
    with open(script, "w", encoding="utf-8") as fh:
        fh.write(SERVE.replace("__TITLE__", args.title))
    os.chmod(script, os.stat(script).st_mode | stat.S_IXUSR | stat.S_IXGRP | stat.S_IXOTH)

    def kb(p):
        return "%.0f KB" % (os.path.getsize(p) / 1024)

    print(dest)
    print("  %-20s %s   framed (%s) — open on this Mac" % (args.slug + ".html", kb(framed), args.device))
    print("  %-20s %s   bare, no panel — what the phone gets" % ("index.html", kb(bare)))
    print("  %-20s %s   double-click to serve on the LAN" % ("serve.command", kb(script)))
    print("  %-20s %s   what it is and how to use it" % ("README.md", kb(os.path.join(dest, "README.md"))))


if __name__ == "__main__":
    main()

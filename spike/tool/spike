    f.add_argument("--dir", help="absolute spike directory, instead of the repo's scratch root")
    f.add_argument("--size", default="1280x900", metavar="WxH",
                   help="window width x minimum height in CSS pixels (default 1280x900)")
    f.add_argument("--scale", default="1", help="device scale factor (default 1)")
    f.add_argument("--theme", default="light", choices=["light", "dark", "both"],
                   help="prefers-color-scheme to render under (default light)")
    f.add_argument("--cell", metavar="ID,ID", help="only these cells (default all)")
    f.add_argument("--query", metavar="Q", help="URL query for a build with no cells")
    f.add_argument("--reduced", action="store_true",

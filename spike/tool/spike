                        "its animations there yields resting frames, which is correct")
    f.add_argument("--fps", type=int, default=VIDEO_DEFAULT_FPS,
                   help="frames per second, 1-60 (default %d)" % VIDEO_DEFAULT_FPS)
    f.add_argument("--duration", type=float, metavar="MS",
                   help="length to record in ms (default: the cell's data-video-duration, else the "
                        "longest end time among the animations running at load)")
    f.add_argument("--hold", type=int, default=VIDEO_DEFAULT_HOLD_MS, metavar="MS",
                   help="how long the last frame stays before the loop restarts (default %d)"
                        % VIDEO_DEFAULT_HOLD_MS)
    f.add_argument("--strip", type=int, default=VIDEO_DEFAULT_STRIP, metavar="N",
                   help="frames in the frame-strip PNG, evenly spaced (default %d)"
                        % VIDEO_DEFAULT_STRIP)

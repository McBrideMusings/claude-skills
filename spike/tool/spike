STORE = os.path.dirname(os.path.abspath(os.path.realpath(__file__)))
KINDS_DIR = os.path.join(STORE, "kinds")
HARNESS_DIR = os.path.join(STORE, "harness")
# The fragment contract lives one level up, at the skill root, alongside SKILL.md and
# UI.md — it is the agent-facing doc, not a tool asset.
CONTRACT_PATH = os.path.join(os.path.dirname(STORE), "CONTRACT.md")

KINDS = {
    "mockup": "Static HTML in the project's real CSS: variants x states, no harness chrome. "
              "`spike shot` screenshots every cell.",
    "prototype": "Several genuinely different working versions of one UI behind the Tweaks "
                 "panel. No palette — the fragment carries the host project's tokens.",
    "wireframe": "Greybox layout: structure and hierarchy only. Colour withheld on purpose.",
}

CHROME_TIMEOUT = 60

# chrome-headless-shell first: it honours any window width, where full Chrome's headless
# mode lays pages out at 500px or wider whatever --window-size says. Playwright installs one
# (`npx playwright install chromium-headless-shell`) and no Playwright code is used.
HEADLESS_SHELL_GLOB = "~/Library/Caches/ms-playwright/chromium_headless_shell-*/*/chrome-headless-shell"
CHROME_CANDIDATES = (
    "chrome-headless-shell",
    "/Applications/Google Chrome.app/Contents/MacOS/Google Chrome",
    "/Applications/Chromium.app/Contents/MacOS/Chromium",
    "google-chrome", "chromium", "chromium-browser",
)

# The queueing stub. A fragment's <script> sits in the BODY and therefore runs before the
# script block at the end of the document, so `atTweaks` has to exist first. This is the
# whole of it: record the call, hand back a handle, and let tweaks.js drain the queue in
# declaration order and fill the handles in.
TWEAKS_STUB = """window.atTweaks=(function(){var q=[];var api={__queue:q};
function val(m){return function(){var h={get:function(){},set:function(){}};
q.push({method:m,args:[].slice.call(arguments),handle:h});return h;};}
function act(m){return function(){q.push({method:m,args:[].slice.call(arguments)});return api;};}
['add','pick','select','slider','stepper','toggle','color','text'].forEach(function(m){api[m]=val(m);});
['section','action','set'].forEach(function(m){api[m]=act(m);});
api.get=function(){};return api;})();"""

TWEAKS_PILL = ('<button class="at-twk-pill" type="button" '
               'title="Show the controls" aria-label="Show the controls">Tweaks</button>')

# Three segments is the most that stays readable across the panel's width; a fourth leaves
# each of them four characters. Above it, the same choice is a dropdown. The variant chooser
# obeys the same rule as a tweak's — it is the same control asking the same kind of question.
SEG_MAX = 3


def die(msg):
    print("spike: " + msg, file=sys.stderr)
    sys.exit(1)


def read(path):
    try:
        with open(path, "r", encoding="utf-8") as f:
            return f.read()
    except OSError as e:
        die("cannot read %s: %s" % (path, e.strerror))


def split_list(value):
    return [p.strip() for p in (value or "").split(",") if p.strip()]


def require_abs(path, what):
    if not os.path.isabs(path):
        die("%s must be an absolute path, got %r. Resolve the repo root with "
            "`git rev-parse --show-toplevel` first." % (what, path))
    return path


# --- fragment parsing -------------------------------------------------------

TEMPLATE_RE = re.compile(
    r"<template\b(?P<attrs>[^>]*)>(?P<body>.*?)</template\s*>",
    re.DOTALL | re.IGNORECASE,
)
ATTR_RE = re.compile(r"""(?P<name>[\w-]+)\s*=\s*(?P<q>["'])(?P<val>.*?)(?P=q)""", re.DOTALL)


def parse_attrs(s):
    return {m.group("name").lower(): m.group("val") for m in ATTR_RE.finditer(s)}


def extract_variants(fragment):
    """Pull <template data-variant="..."> blocks out of the fragment.

    Returns (variants, remainder). Each variant is a dict with name/state/motion/video_duration/body/raw.
    """
    variants = []
    for m in TEMPLATE_RE.finditer(fragment):
        attrs = parse_attrs(m.group("attrs"))
        if "data-variant" not in attrs:
            continue
        variants.append({
            "name": attrs["data-variant"],
            "state": attrs.get("data-state", ""),
            "motion": "data-motion" in m.group("attrs").lower(),
            "video_duration": attrs.get("data-video-duration"),
            "body": m.group("body"),
            "raw": m.group(0),
        })
    remainder = fragment
    for v in variants:
        remainder = remainder.replace(v["raw"], "")
    return variants, remainder


# --- assembly ---------------------------------------------------------------

def build_panel(variants, title, subtitle):
    """The Tweaks card: a header, the variant chooser, and whatever the fragment registers.

    The variant group appears only when there is a choice to make. A single-variant
    prototype is one design, and a chooser offering one option answers nothing. Closing the
    card leaves the pill.
    """
    has_motion = any(v["motion"] for v in variants)

    parts = ['<nav class="at-twk" aria-label="Prototype controls">',
             '  <div class="at-twk-head">',
             '    <div class="at-twk-titles">',
             '      <div class="at-twk-title">%s</div>' % html.escape(title)]
    if subtitle:
        parts.append('      <div class="at-twk-sub">%s</div>' % html.escape(subtitle))
    parts += ['    </div>',
              '    <button class="at-twk-x" type="button" title="Hide the controls" '
              'aria-label="Hide the controls">&#215;</button>',
              '  </div>',
              '  <div class="at-twk-body">']

    if len(variants) > 1 or has_motion:
        replay = ('<button class="at-twk-replay" type="button" title="Replay animation" '
                  'aria-label="Replay animation">&#8635;</button>' if has_motion else "")
        parts.append('    <div class="at-twk-group">')
        parts.append('      <div class="at-twk-label"><span>Variant</span>%s</div>' % replay)
        if len(variants) > SEG_MAX:
            parts.append('      <select class="at-twk-field at-twk-variant-select" '
                         'aria-label="Variant">')
            for i, v in enumerate(variants):
                sel = " selected" if i == 0 else ""
                parts.append('        <option value="%d"%s>%s</option>'
                             % (i, sel, html.escape(v["name"])))
            parts.append('      </select>')
        else:
            parts.append('      <div class="at-twk-seg">')
            for i, v in enumerate(variants):
                attrs = ' data-active aria-current="true"' if i == 0 else ""
                parts.append('        <button class="at-twk-opt at-twk-variant" '
                             'type="button"%s>%s</button>' % (attrs, html.escape(v["name"])))
            parts.append('      </div>')
        parts.append('    </div>')

    parts += ['  </div>', '</nav>', TWEAKS_PILL]
    return "\n".join(parts)


def kebab(text):
    return re.sub(r"[^a-z0-9]+", "-", text.lower()).strip("-")


def video_duration_attr(variant):
    """The cell's `data-video-duration="MS"`: how long `spike video` records it."""
    raw = variant["video_duration"]
    if raw is None:
        return ""
    try:
        ok = 0 < float(raw) < 600000
    except ValueError:
        ok = False
    if not ok:
        die("data-video-duration on %r must be a number of milliseconds above 0 and below 600000 (got %r)"
            % (variant["name"], raw))
    return ' data-video-duration="%s"' % html.escape(raw, quote=True)


def mockup_cells(variants):
    """One cell per <template data-variant data-state>. The cell id is variant-state."""
    cells, seen = [], set()
    for v in variants:
        name = kebab(v["name"])
        state = kebab(v["state"]) or "default"
        if not name:
            die("a <template data-variant> has a name with no letters or digits: %r" % v["name"])
        cid = "%s-%s" % (name, state)
        if cid in seen:
            die("two cells are both %r — each variant x state pair appears once. Give the "
                "second a different data-variant or data-state." % cid)
        seen.add(cid)
        cells.append((cid, v))
    return cells


def cmd_build(args):
    kind = args.kind
    if kind not in KINDS:
        die("unknown kind %r. Known kinds: %s" % (kind, ", ".join(sorted(KINDS))))

    fragment_path = require_abs(args.fragment, "--fragment")
    out_path = require_abs(args.out, "--out")
    fragment = read(fragment_path)

    if not fragment.strip():
        die("fragment %s is empty — nothing to build" % fragment_path)

    # Match on a real tag boundary — `<header>` must not trip the `<head>` check.
    for pattern, shown, why in (
        (r"<!doctype\b", "<!doctype", "the tool supplies the doctype"),
        (r"<html[\s>]", "<html>", "the tool supplies <html>"),
        (r"<head[\s>]", "<head>", "the tool supplies <head>"),
        (r"<body[\s>]", "<body>", "the tool supplies <body>"),
    ):
        if re.search(pattern, fragment, re.IGNORECASE):
            die("fragment contains %s — %s. Write body content only (see CONTRACT.md)."
                % (shown, why))

    # Matches a literal absolute or protocol-relative URL, never a relative fetch of a
    # sibling file.
    net = re.search(r"""<link\b[^>]*\bhref\s*=|@import\s+url\(|"""
                    r"""src\s*=\s*["'](?:https?:|//)|"""
                    r"""\bfetch\s*\(\s*["'](?:https?:|//)|"""
                    r"""\bimport\s*\(\s*["'](?:https?:|//)|"""
                    r"""\bnew\s+XMLHttpRequest\b""",
                    fragment, re.IGNORECASE)
    if net:
        die("fragment makes a network request (%r). Builds are hermetic: inline the CSS, "
            "embed rasters as data: URIs, never link a webfont, and never fetch/XHR an "
            "absolute or protocol-relative URL. Need real user data instead of a baked "
            "fixture? Use <input type=\"file\"> + FileReader — see CONTRACT.md."
            % net.group(0).strip())

    css = []
    scripts = []
    head_scripts = []
    root_attrs = ""
    variants, remainder = extract_variants(fragment)

    if kind == "mockup":
        if not variants:
            die("a mockup needs at least one <template data-variant=\"...\" "
                "[data-state=\"...\"]> block. See CONTRACT.md.")
        cells = mockup_cells(variants)
        css.append(read(os.path.join(KINDS_DIR, "mockup.css")))
        body = "%s\n<div id=\"mk\">\n%s\n</div>" % (remainder.strip(), "\n".join(
            '<div class="mk-cell" id="%s" data-variant="%s" data-state="%s"%s>\n%s\n</div>'
            % (cid, html.escape(v["name"], quote=True), html.escape(v["state"] or "default", quote=True),
               video_duration_attr(v), v["body"].strip())
            for cid, v in cells))
    else:
        css += [read(os.path.join(KINDS_DIR, "_base.css")),
                read(os.path.join(KINDS_DIR, kind + ".css"))]
        if kind == "prototype":
            if not variants:
                die("a prototype needs at least one <template data-variant=\"...\"> block. "
                    "See CONTRACT.md.")
            css.append(read(os.path.join(HARNESS_DIR, "chrome.css")))
            css.append(read(os.path.join(HARNESS_DIR, "tweaks.css")))
            scripts.append(read(os.path.join(HARNESS_DIR, "tweaks.js")))
            # The stub goes in <head>, because the fragment's own <script> is in the body
            # and therefore runs before the block that defines the real registry.
            head_scripts.append(TWEAKS_STUB)
            root_attrs += " data-at-tweaks"
            # The stage is a <div>, never a <main>: the design being prototyped owns the one
            # <main> a page may have, and a second one lets each side's `main` rules hit the
            # other.
            body = "%s\n%s\n<div id=\"at-stage\"></div>\n%s" % (
                build_panel(variants, args.title, args.subtitle),
                remainder.strip(),
                "\n".join(v["raw"] for v in variants),
            )
        else:
            body = fragment.strip()
            if "<main" not in body.lower():
                body = "<main>\n%s\n</main>" % body

    if args.extra_css:
        css.append(read(require_abs(args.extra_css, "--extra-css")))

    doc = [
        "<!DOCTYPE html>",
        '<html lang="%s" data-at-kind="%s"%s>' % (html.escape(args.lang), kind, root_attrs),
        "<head>",
        '<meta charset="utf-8">',
        '<meta name="viewport" content="width=device-width, initial-scale=1">',
        '<meta name="generator" content="spike/%s">' % kind,
        "<title>%s</title>" % html.escape(args.title),
        "<style>",
        "\n".join(c.strip() for c in css),
        "</style>",
    ]
    for sc in head_scripts:
        doc.append("<script>%s</script>" % sc)
    doc += ["</head>", "<body>", body]
    if scripts:
        doc.append("<script>")
        doc.append("\n".join(sc.strip() for sc in scripts))
        doc.append("</script>")
    doc += ["</body>", "</html>", ""]

    out_dir = os.path.dirname(out_path)
    if out_dir:
        os.makedirs(out_dir, exist_ok=True)
    with open(out_path, "w", encoding="utf-8") as f:
        f.write("\n".join(doc))

    size = os.path.getsize(out_path)
    detail = "kind=%s" % kind
    if kind == "mockup":
        detail += ", cells=%d" % len(cells)
    elif kind == "prototype":
        detail += ", variants=%d" % len(variants)
    print("%s  (%s, %.1f KB)" % (out_path, detail, size / 1024.0))
    if kind == "mockup":
        print("Next: spike shot <slug> — then open every PNG and look at it.", file=sys.stderr)
    else:
        print("Screenshot it and look at it before handing it over.", file=sys.stderr)


# --- shot -------------------------------------------------------------------

CELL_RE = re.compile(r'<div class="mk-cell" id="([^"]+)"')

MEASURE_JS = ("<script>addEventListener('load',function(){var r=document.documentElement;"
              "r.setAttribute('data-mk-h',String(r.scrollHeight));"
              "r.setAttribute('data-mk-w',String(innerWidth));});</script>")


def find_chrome():
    override = os.environ.get("SPIKE_CHROME")
    if override:
        if not os.path.exists(override):
            die("SPIKE_CHROME=%s does not exist" % override)
        return override
    shells = sorted(glob.glob(os.path.expanduser(HEADLESS_SHELL_GLOB)))
    if shells:
        return shells[-1]
    for cand in CHROME_CANDIDATES:
        path = cand if os.path.isabs(cand) else shutil.which(cand)
        if path and os.path.exists(path):
            return path
    die("no Chrome found. Install Google Chrome, or chrome-headless-shell with "
        "`npx playwright install chromium-headless-shell`, or set SPIKE_CHROME to a binary.")


def spike_dir(slug, explicit):
    if explicit:
        return require_abs(explicit, "--dir")
    tool = os.path.expanduser("~/.claude/tools/repo-slug")
    proc = subprocess.run([tool, "--path"], capture_output=True, text=True)
    if proc.returncode != 0 or not proc.stdout.strip():
        die("cannot resolve the scratch root with %s --path; pass --dir <abs-dir>" % tool)
    return os.path.join(proc.stdout.strip(), "spikes", slug)


def run_chrome(chrome, profile, flags, url, done):
    """Run headless Chrome until `done(stdout, stderr)` is true, then end it.

    Chrome finishes its work (it prints the DOM, or "N bytes written to file") and then
    keeps running instead of exiting, so waiting for the process hangs. The output is the
    signal; the process group is killed once it appears.
    """
    cmd = [chrome, "--headless", "--disable-gpu", "--hide-scrollbars",
           "--no-first-run", "--user-data-dir=" + profile] + flags + [url]
    with tempfile.TemporaryFile("w+") as out, tempfile.TemporaryFile("w+") as err:
        proc = subprocess.Popen(cmd, stdout=out, stderr=err, start_new_session=True)
        try:
            deadline = time.time() + CHROME_TIMEOUT
            while time.time() < deadline:
                out.seek(0)
                err.seek(0)
                stdout, stderr = out.read(), err.read()
                if done(stdout, stderr):
                    return stdout, stderr
                if proc.poll() is not None:
                    return stdout, stderr
                time.sleep(0.1)
            die("Chrome did not finish within %ds on %s" % (CHROME_TIMEOUT, url))
        finally:
            try:
                os.killpg(proc.pid, signal.SIGKILL)
            except (ProcessLookupError, PermissionError):
                pass
            proc.wait()


def cmd_shot(args):
    if not re.match(r"^[a-z0-9]+(-[a-z0-9]+)*$", args.slug):
        die("slug %r must be kebab-case: lowercase letters, digits and single hyphens" % args.slug)
    m = re.match(r"^(\d{2,5})\s*[x×]\s*(\d{2,5})$", args.size.strip())
    if not m:
        die("--size must be WxH in CSS pixels, e.g. 390x844 (got %r)" % args.size)
    width, min_height = int(m.group(1)), int(m.group(2))

    out_dir = spike_dir(args.slug, args.dir)
    page = os.path.join(out_dir, args.slug + ".html")
    source = read(page)
    cell_ids = CELL_RE.findall(source)
    query = ("?" + args.query.lstrip("?")) if args.query else ""
    if cell_ids:
        if args.cell:
            want = split_list(args.cell)
            missing = [c for c in want if c not in cell_ids]
            if missing:
                die("no such cell %s. Cells in %s: %s"
                    % (", ".join(missing), page, ", ".join(cell_ids)))
            cell_ids = want
        targets = [(cid, query + "#" + cid) for cid in cell_ids]
    else:
        # A wireframe or a prototype is one page: one PNG, named for the slug and the query.
        if args.cell:
            die("%s has no mockup cells, so --cell has nothing to select" % page)
        stem = args.slug + (("-" + kebab(args.query)) if args.query else "")
        targets = [(stem, query)]

    themes = ["light", "dark"] if args.theme == "both" else [args.theme]
    chrome = find_chrome()
    written = []
    with tempfile.TemporaryDirectory() as profile:
        # Measure each cell once: a design taller than the window would otherwise be
        # cropped at the window's height without a word.
        probe = os.path.join(out_dir, ".%s.measure.html" % args.slug)
        try:
            with open(probe, "w", encoding="utf-8") as f:
                f.write(source.replace("</body>", MEASURE_JS + "</body>"))
            for stem, suffix in targets:
                url = "file://%s%s" % (probe, suffix)
                stdout, stderr = run_chrome(
                    chrome, profile,
                    ["--window-size=%d,%d" % (width, min_height), "--dump-dom"], url,
                    lambda o, e: "</html>" in o)
                hm = re.search(r'data-mk-h="(\d+)"', stdout)
                if not hm:
                    die("could not measure %s: Chrome printed no height.\n%s"
                        % (stem, stderr.strip()[-400:]))
                wm = re.search(r'data-mk-w="(\d+)"', stdout)
                if not wm or int(wm.group(1)) != width:
                    die("%s lays pages out %s px wide when asked for %d, so the shot would show a "
                        "different layout. Install chrome-headless-shell "
                        "(`npx playwright install chromium-headless-shell`) or set SPIKE_CHROME."
                        % (chrome, wm.group(1) if wm else "an unknown number of", width))
                height = max(min_height, int(hm.group(1)))
                for theme in themes:
                    name = stem + ("-dark" if theme == "dark" else "") + ".png"
                    out = os.path.join(out_dir, name)
                    # Chrome numbers the schemes 0 = dark, 1 = light. Passed every time:
                    # left unset, the shot follows the OS appearance.
                    flags = ["--window-size=%d,%d" % (width, height),
                             "--force-device-scale-factor=%s" % args.scale,
                             "--blink-settings=preferredColorScheme=%d"
                             % (0 if theme == "dark" else 1),
                             "--screenshot=" + out]
                    run_chrome(chrome, profile, flags, "file://%s%s" % (page, suffix),
                               lambda o, e: "bytes written to file" in e)
                    if not os.path.isfile(out) or os.path.getsize(out) == 0:
                        die("Chrome wrote no screenshot for %s (%s)" % (stem, theme))
                    written.append(out)
        finally:
            if os.path.exists(probe):
                os.remove(probe)
    for path in written:
        print(path)


# --- video -------------------------------------------------------------------

VIDEO_DEFAULT_FPS = 30
VIDEO_DEFAULT_HOLD_MS = 600
VIDEO_DEFAULT_STRIP = 6

# The page's clock, installed before any page script runs. It replaces performance.now,
# Date, setTimeout, setInterval and requestAnimationFrame with a clock that moves only when
# the recorder says so, so a script sees the same times on every run. CSS animations and
# transitions run on the browser's own clock, which cannot be replaced: a style sheet holds
# every CSS animation at its start from the first style calculation, a transition is paused
# the moment a script callback creates it, and the recorder sets each one's currentTime from
# this clock.
VIDEO_CLOCK_JS = """(function(){
  var now = 0, id = 0, timers = [], frames = [], started = new WeakMap(), tracked = [];
  var RealDate = Date, base = 1700000000000, realRaf = window.requestAnimationFrame.bind(window);
  function FakeDate(){
    if (!(this instanceof FakeDate)) return new RealDate(base + now).toString();
    if (arguments.length === 0) return new RealDate(base + now);
    return Reflect.construct(RealDate, arguments, new.target);
  }
  FakeDate.prototype = RealDate.prototype;
  RealDate.prototype.constructor = FakeDate;
  FakeDate.now = function(){ return base + now; };
  FakeDate.parse = RealDate.parse;
  FakeDate.UTC = RealDate.UTC;
  window.Date = FakeDate;
  var hold = new CSSStyleSheet();
  hold.replaceSync("*, ::before, ::after { animation-play-state: paused !important; }");
  document.adoptedStyleSheets = [hold];
  performance.now = function(){ return now; };
  function addTimer(fn, ms, args, every){
    ms = Math.max(1, +ms || 0);
    timers.push({id: ++id, at: now + ms, ms: ms, fn: fn, args: args, every: every});
    return id;
  }
  window.setTimeout = function(fn, ms){ return addTimer(fn, ms, [].slice.call(arguments, 2), false); };
  window.setInterval = function(fn, ms){ return addTimer(fn, ms, [].slice.call(arguments, 2), true); };
  window.clearTimeout = window.clearInterval = function(i){
    timers = timers.filter(function(t){ return t.id !== i; });
  };
  window.requestAnimationFrame = function(fn){ frames.push({id: ++id, fn: fn}); return id; };
  window.cancelAnimationFrame = function(i){
    frames = frames.filter(function(f){ return f.id !== i; });
  };
  function adopt(){
    document.getAnimations().forEach(function(a){
      if (started.has(a)) return;
      started.set(a, now);
      tracked.push(a);
      a.pause();
    });
  }
  function run(fn, args){
    try { fn.apply(window, args); } catch (e) { console.error(e); }
    adopt();
  }
  window.__video = {
    adopt: adopt,
    step: function(to){
      var guard = 0;
      for (;;) {
        var next = null;
        timers.forEach(function(t){ if (t.at <= to && (!next || t.at < next.at)) next = t; });
        if (!next || ++guard > 100000) break;
        now = Math.max(now, next.at);
        if (next.every) next.at += next.ms; else timers.splice(timers.indexOf(next), 1);
        run(next.fn, next.args);
      }
      now = Math.max(now, to);
      var due = frames;
      frames = [];
      due.forEach(function(f){ run(f.fn, [now]); });
      tracked.forEach(function(a){ a.currentTime = Math.max(0, now - started.get(a)); });
      return new Promise(function(done){ realRaf(function(){ realRaf(function(){ done(true); }); }); });
    }
  };
})()"""

# Called once the page has loaded: takes over every animation already running (they start at
# 0 ms) and reports the page's size and the longest end time among the animations under the
# root. An animation that never ends counts for one iteration.
VIDEO_PREPARE_JS = """(function(sel){
  var root = sel ? document.getElementById(sel) : document.documentElement;
  window.__video.adopt();
  var end = 0, count = 0;
  root.getAnimations({subtree: true}).forEach(function(a){
    count++;
    var t = a.effect.getComputedTiming();
    var e = isFinite(t.endTime) ? t.endTime : t.delay + t.duration;
    if (e > end) end = e;
  });
  var r = document.documentElement;
  return {count: count, end: end, declared: root.getAttribute("data-video-duration"),
          height: r.scrollHeight, width: innerWidth};
})(%s)"""

VIDEO_STEP_JS = "window.__video.step(%s)"


class Cdp:
    """A Chrome DevTools Protocol client over one WebSocket, standard library only."""

    def __init__(self, ws_url):
        u = urllib.parse.urlparse(ws_url)
        try:
            self.sock = socket.create_connection((u.hostname, u.port), timeout=CHROME_TIMEOUT)
        except OSError as e:
            die("cannot reach Chrome's DevTools port: %s" % e)
        key = base64.b64encode(os.urandom(16)).decode()
        self.sock.sendall(("GET %s HTTP/1.1\r\nHost: %s:%d\r\nUpgrade: websocket\r\n"
                           "Connection: Upgrade\r\nSec-WebSocket-Key: %s\r\n"
                           "Sec-WebSocket-Version: 13\r\n\r\n"
                           % (u.path, u.hostname, u.port, key)).encode())
        head = b""
        while b"\r\n\r\n" not in head:
            chunk = self.sock.recv(1)
            if not chunk:
                die("Chrome closed the DevTools connection during the handshake")
            head += chunk
        if b" 101 " not in head.split(b"\r\n")[0]:
            die("Chrome refused the DevTools WebSocket: %s" % head.split(b"\r\n")[0].decode())
        self.next_id = 0
        self.events = []

    def _read(self, n):
        buf = b""
        while len(buf) < n:
            try:
                chunk = self.sock.recv(n - len(buf))
            except socket.timeout:
                die("Chrome did not answer within %ds" % CHROME_TIMEOUT)
            if not chunk:
                die("Chrome closed the DevTools connection")
            buf += chunk
        return buf

    def _recv(self):
        message = b""
        while True:
            b1, b2 = self._read(2)
            op, size = b1 & 0x0F, b2 & 0x7F
            if size == 126:
                size = struct.unpack(">H", self._read(2))[0]
            elif size == 127:
                size = struct.unpack(">Q", self._read(8))[0]
            payload = self._read(size)
            if op == 0x9:
                continue
            if op == 0x8:
                die("Chrome closed the DevTools connection")
            message += payload
            if b1 & 0x80:
                return json.loads(message)

    def _send(self, text):
        data = text.encode()
        mask = os.urandom(4)
        n = len(data)
        head = bytes([0x81])
        if n < 126:
            head += bytes([0x80 | n])
        elif n < 65536:
            head += bytes([0x80 | 126]) + struct.pack(">H", n)
        else:
            head += bytes([0x80 | 127]) + struct.pack(">Q", n)
        masked = bytes(b ^ mask[i % 4] for i, b in enumerate(data))
        self.sock.sendall(head + mask + masked)

    def call(self, method, params=None, session=None):
        self.next_id += 1
        msg = {"id": self.next_id, "method": method, "params": params or {}}
        if session:
            msg["sessionId"] = session
        self._send(json.dumps(msg))
        while True:
            reply = self._recv()
            if reply.get("id") == self.next_id:
                if "error" in reply:
                    die("DevTools %s failed: %s" % (method, reply["error"].get("message")))
                return reply.get("result", {})
            self.events.append(reply)

    def wait_event(self, method, session):
        for i, ev in enumerate(self.events):
            if ev.get("method") == method and ev.get("sessionId") == session:
                del self.events[i]
                return
        while True:
            ev = self._recv()
            if ev.get("method") == method and ev.get("sessionId") == session:
                return
            self.events.append(ev)


def launch_chrome(chrome, profile):
    """Start Chrome with a DevTools port; return (process, browser WebSocket URL)."""
    cmd = [chrome, "--headless", "--disable-gpu", "--hide-scrollbars", "--no-first-run",
           "--remote-debugging-port=0", "--user-data-dir=" + profile, "about:blank"]
    err = tempfile.TemporaryFile("w+")
    proc = subprocess.Popen(cmd, stdout=subprocess.DEVNULL, stderr=err, start_new_session=True)
    deadline = time.time() + CHROME_TIMEOUT
    while time.time() < deadline:
        err.seek(0)
        m = re.search(r"DevTools listening on (ws://\S+)", err.read())
        if m:
            return proc, m.group(1)
        if proc.poll() is not None:
            break
        time.sleep(0.1)
    stop_chrome(proc)
    die("Chrome did not open a DevTools port")


def stop_chrome(proc):
    try:
        os.killpg(proc.pid, signal.SIGKILL)
    except (ProcessLookupError, PermissionError):
        pass
    proc.wait()


def require_tool(name):
    path = shutil.which(name) or os.path.join("/opt/homebrew/bin", name)
    if not os.path.exists(path):
        die("`%s` is not installed, and spike video needs it to encode frames "
            "(macOS: `brew install webp ffmpeg`)." % name)
    return path


def video_times(end, fps):
    """Frame timestamps in ms from 0 to `end` inclusive, one every 1000/fps."""
    step = 1000.0 / fps
    n = max(1, int(round(end / step)))
    times = [min(end, i * step) for i in range(n)]
    times.append(float(end))
    return times


def video_durations(times, hold):
    """Per-frame display time in whole ms: the gaps between timestamps, then the hold."""
    marks = [int(round(t)) for t in times]
    gaps = [marks[i + 1] - marks[i] for i in range(len(marks) - 1)]
    return [max(1, g) for g in gaps] + [max(1, hold)]


def cmd_video(args):
    if not re.match(r"^[a-z0-9]+(-[a-z0-9]+)*$", args.slug):
        die("slug %r must be kebab-case: lowercase letters, digits and single hyphens" % args.slug)
    m = re.match(r"^(\d{2,5})\s*[x×]\s*(\d{2,5})$", args.size.strip())
    if not m:
        die("--size must be WxH in CSS pixels, e.g. 390x844 (got %r)" % args.size)
    width, min_height = int(m.group(1)), int(m.group(2))
    if args.fps < 1 or args.fps > 60:
        die("--fps must be between 1 and 60 (got %s)" % args.fps)
    if args.hold < 1 or (args.duration is not None and args.duration <= 0):
        die("--hold must be at least 1 ms and --duration above 0")
    if not 0 <= args.quality <= 100:
        die("--quality must be between 0 and 100 (got %s)" % args.quality)
    try:
        float(args.scale)
    except ValueError:
        die("--scale must be a number (got %r)" % args.scale)
    if args.strip < 2:
        die("--strip must be at least 2 frames (got %s)" % args.strip)

    img2webp, ffmpeg = require_tool("img2webp"), require_tool("ffmpeg")
    out_dir = spike_dir(args.slug, args.dir)
    page = os.path.join(out_dir, args.slug + ".html")
    source = read(page)
    cell_ids = CELL_RE.findall(source)
    query = ("?" + args.query.lstrip("?")) if args.query else ""
    if cell_ids:
        if args.cell:
            want = split_list(args.cell)
            missing = [c for c in want if c not in cell_ids]
            if missing:
                die("no such cell %s. Cells in %s: %s"
                    % (", ".join(missing), page, ", ".join(cell_ids)))
            cell_ids = want
        targets = [(cid, query + "#" + cid, "#" + cid) for cid in cell_ids]
    else:
        if args.cell:
            die("%s has no mockup cells, so --cell has nothing to select" % page)
        stem = args.slug + (("-" + kebab(args.query)) if args.query else "")
        targets = [(stem, query, None)]

    themes = ["light", "dark"] if args.theme == "both" else [args.theme]
    chrome = find_chrome()
    written = []
    with tempfile.TemporaryDirectory() as profile, tempfile.TemporaryDirectory() as frames:
        proc, ws_url = launch_chrome(chrome, profile)
        try:
            cdp = Cdp(ws_url)
            for stem, suffix, selector in targets:
                for theme in themes:
                    suffix_name = ("-dark" if theme == "dark" else "") + ("-reduced" if args.reduced else "")
                    base = os.path.join(out_dir, stem + suffix_name)
                    written += video_one(cdp, img2webp, ffmpeg, frames, args, page, suffix,
                                        selector, theme, width, min_height, base)
        finally:
            stop_chrome(proc)
    for path in written:
        print(path)


def video_one(cdp, img2webp, ffmpeg, frames, args, page, suffix, selector, theme,
             width, min_height, base):
    target = cdp.call("Target.createTarget", {"url": "about:blank"})["targetId"]
    session = cdp.call("Target.attachToTarget", {"targetId": target, "flatten": True})["sessionId"]
    try:
        send = lambda method, params=None: cdp.call(method, params, session)
        send("Page.enable")
        send("Emulation.setEmulatedMedia", {"features": [
            {"name": "prefers-color-scheme", "value": theme},
            {"name": "prefers-reduced-motion", "value": "reduce" if args.reduced else "no-preference"}]})
        send("Emulation.setDeviceMetricsOverride", {
            "width": width, "height": min_height, "deviceScaleFactor": float(args.scale),
            "mobile": False})
        send("Page.addScriptToEvaluateOnNewDocument", {"source": VIDEO_CLOCK_JS})
        send("Page.navigate", {"url": "file://%s%s" % (page, suffix)})
        cdp.wait_event("Page.loadEventFired", session)
        sel = json.dumps(selector.lstrip("#") if selector else None)
        info = send("Runtime.evaluate", {
            "expression": VIDEO_PREPARE_JS % sel, "returnByValue": True})["result"]["value"]
        height = max(min_height, int(info["height"]))
        send("Emulation.setDeviceMetricsOverride", {
            "width": width, "height": height, "deviceScaleFactor": float(args.scale),
            "mobile": False})
        if args.duration is not None:
            end = float(args.duration)
        elif info["declared"] is not None:
            end = float(info["declared"])
        else:
            end = float(info["end"])
        times = video_times(end, args.fps) if end > 0 else [0.0]
        if end <= 0:
            sys.stderr.write("spike video: %s has no length: no --duration, no data-video-duration "
                             "and no animation with a length at load, so every frame is the "
                             "resting state%s. A page whose script drives the motion needs one "
                             "of the first two.\n" % (os.path.basename(base),
                             " under prefers-reduced-motion" if args.reduced else ""))
        shot_dir = tempfile.mkdtemp(dir=frames)
        paths = []
        for i, t in enumerate(times):
            send("Runtime.evaluate", {"expression": VIDEO_STEP_JS % json.dumps(t),
                                      "awaitPromise": True, "returnByValue": True})
            data = send("Page.captureScreenshot", {"format": "png"})["data"]
            path = os.path.join(shot_dir, "f%04d.png" % i)
            with open(path, "wb") as f:
                f.write(base64.b64decode(data))
            paths.append(path)
    finally:
        try:
            cdp.call("Target.closeTarget", {"targetId": target})
        except SystemExit:
            pass

    # Animated WebP: lossy, looping forever, gaps between timestamps, a hold on the last frame.
    durations = video_durations(times, args.hold)
    cmd = [img2webp, "-loop", "0", "-lossy", "-q", str(args.quality), "-m", "4"]
    for path, d in zip(paths, durations):
        cmd += ["-d", str(d), path]
    webp = base + ".webp"
    cmd += ["-o", webp]
    proc = subprocess.run(cmd, capture_output=True, text=True)
    if proc.returncode != 0 or not os.path.getsize(webp):
        die("img2webp failed: %s" % proc.stderr.strip()[-400:])

    # Frame strip: --strip frames spread evenly from the first to the last, side by side.
    n = min(args.strip, len(paths))
    picks = sorted({int(round(i * (len(paths) - 1) / max(1, n - 1))) for i in range(n)})
    strip = base + "-strip.png"
    cmd = [ffmpeg, "-y", "-loglevel", "error"]
    for i in picks:
        cmd += ["-i", paths[i]]
    if len(picks) == 1:
        cmd += ["-frames:v", "1", strip]
    else:
        cmd += ["-filter_complex", "".join("[%d:v]" % k for k in range(len(picks)))
                + "hstack=inputs=%d" % len(picks), "-frames:v", "1", strip]
    proc = subprocess.run(cmd, capture_output=True, text=True)
    if proc.returncode != 0 or not os.path.isfile(strip):
        die("ffmpeg failed: %s" % proc.stderr.strip()[-400:])
    sys.stderr.write("spike video: %s — %d frame(s), %d ms, strip at %s ms\n" % (
        os.path.basename(webp), len(paths), int(times[-1]),
        ", ".join(str(int(round(times[i]))) for i in picks)))
    return [webp, strip]



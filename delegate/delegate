#!/usr/bin/env bash
# delegate — cross-vendor delegation resolver.
#
# Resolves a non-interactive coding agent from $CLAUDE_DELEGATE_AGENT and runs it.
# The delegate flavors (audit dual, iterate delegate) call only these three verbs
# and never name a specific vendor:
#
#   delegate agent                       print the resolved agent (codex|reasonix), or fail
#   delegate check                       is the resolved agent authed & reachable? (exit 0/1)
#   delegate exec [--headless] <prompt-file> <outfile>
#                                          run the agent non-interactively with the prompt; output to <outfile>.
#                                          default: in a visible Terminal.app window you can watch.
#                                          --headless: no window — run as a plain subprocess (backend-only,
#                                          for cron / SSH / no-GUI where AppleScript can't open a window).
#
# Selection: $CLAUDE_DELEGATE_AGENT, set per-profile in settings.local.json
# (reasonix on personal, codex on work). A repo can override it in its own
# .claude/settings.local.json. Unset/unknown is a hard error — never guess a vendor.
set -eu

KNOWN="codex reasonix"

resolve_agent() {
  local a="${CLAUDE_DELEGATE_AGENT:-}"
  if [ -z "$a" ]; then
    echo "delegate: no delegate configured — set CLAUDE_DELEGATE_AGENT (codex|reasonix) in settings.local.json" >&2
    return 1
  fi
  case " $KNOWN " in
    *" $a "*) printf '%s\n' "$a" ;;
    *) echo "delegate: unknown agent '$a' (expected one of: $KNOWN)" >&2; return 1 ;;
  esac
}

cmd_agent() { resolve_agent; }

cmd_check() {
  local a out; a="$(resolve_agent)" || return 1
  case "$a" in
    codex)
      out="$(codex login status 2>&1 || true)"
      if printf '%s' "$out" | grep -qi "logged in"; then
        echo "delegate: codex ready"
      else
        echo "delegate: codex not authenticated — run 'codex login'" >&2; return 1
      fi
      ;;
    reasonix)
      out="$(reasonix doctor 2>&1 || true)"
      if printf '%s' "$out" | grep -q "key:present"; then
        echo "delegate: reasonix ready"
      else
        echo "delegate: reasonix not authenticated — set DEEPSEEK_API_KEY, then run 'reasonix setup'" >&2; return 1
      fi
      ;;
  esac
}

cmd_exec() {
  local a; a="$(resolve_agent)" || return 1
  local headless=0
  if [ "${1:-}" = "--headless" ]; then headless=1; shift; fi
  local promptfile="${1:-}" outfile="${2:-}"
  if [ -z "$promptfile" ] || [ -z "$outfile" ]; then
    echo "usage: delegate exec [--headless] <prompt-file> <outfile>" >&2; return 2
  fi
  [ -f "$promptfile" ] || { echo "delegate: prompt file not found: $promptfile" >&2; return 1; }

  local runner
  case "$a" in
    codex)    runner="codex exec -s workspace-write -c sandbox_workspace_write.network_access=true" ;;   # non-interactive; prompt on stdin; network on so gh/git can reach api.github.com, file-sandbox stays on
    reasonix) runner="reasonix run" ;; # non-interactive; prompt on stdin
  esac

  : > "$outfile"

  # Backend-only path: no window, no AppleScript. Run the agent as a plain subprocess
  # in the current dir, output straight to the file. For cron / SSH / any context with no
  # GUI session to open a Terminal window in. The windowed path below stays the default —
  # this is opt-in via --headless. No sentinel needed: the call is synchronous, so it
  # returns exactly when the agent exits.
  if [ "$headless" -eq 1 ]; then
    cat "$promptfile" | $runner > "$outfile" 2>&1 || true
    echo "delegate: $a finished (headless) → $outfile"
    return 0
  fi

  # The real command runs in a temp script so the AppleScript string stays trivial
  # (just "bash /tmp/xxx") and we never fight do-script quoting. After the agent
  # finishes, the script prints a "done" line, deletes itself ($0), and exits — leaving
  # the window open at its idle login shell. We deliberately do NOT close the window from
  # inside: closing a window that still has a live process (bash/osascript) makes Terminal
  # pop its "terminate running processes?" dialog. Letting bash exit means only the login
  # shell remains, so the user closes the window (Cmd-W / red button) with no prompt —
  # same as any other idle terminal window.
  local cmdfile; cmdfile="$(mktemp -t delegate-run.XXXXXX)"
  {
    printf 'cd %q\n' "$PWD"
    printf 'cat %q | %s 2>&1 | tee %q\n' "$promptfile" "$runner" "$outfile"
    printf 'printf "\\n__DELEGATE_DONE__\\n" >> %q\n' "$outfile"
    cat <<'CLOSER'
printf "\n\033[2m──── delegate finished — close this window when done ────\033[0m\n"
rm -f "$0"
CLOSER
  } > "$cmdfile"

  # Spawn the window. Cold-start guard: if Terminal was NOT already running, launching
  # it opens a blank default window — so run our script IN that window instead of
  # letting `do script` spawn a second one (which would orphan the blank one). If
  # Terminal WAS running, a plain `do script` opens a fresh window so we never hijack
  # one of the user's existing windows.
  osascript >/dev/null 2>&1 <<OSA
set wasRunning to application "Terminal" is running
tell application "Terminal"
  activate
  if wasRunning then
    do script "bash $cmdfile"
  else
    repeat 50 times
      if (count of windows) > 0 then exit repeat
      delay 0.1
    end repeat
    if (count of windows) > 0 then
      do script "bash $cmdfile" in window 1
    else
      do script "bash $cmdfile"
    end if
  end if
end tell
OSA

  # Block until the agent finishes (skills run this verb in the background, so the
  # harness notifies on exit). Sentinel in the output file is the source of truth.
  local i=0
  while ! grep -q "__DELEGATE_DONE__" "$outfile" 2>/dev/null; do
    sleep 3; i=$((i + 1))
    if [ "$i" -ge 800 ]; then
      echo "delegate: timed out (~40m) waiting for $a — leaving the window open for inspection" >&2
      return 1
    fi
  done

  # Output ready: strip the sentinel and return. The window is left open at its idle
  # shell showing the full output; the user closes it themselves (no terminate prompt,
  # since only the login shell remains). The temp script already self-deleted via $0.
  grep -v "__DELEGATE_DONE__" "$outfile" > "$outfile.tmp" 2>/dev/null && mv "$outfile.tmp" "$outfile" || true
  echo "delegate: $a finished → $outfile (window left open — close it when done)"
}

case "${1:-}" in
  agent) cmd_agent ;;
  check) cmd_check ;;
  exec)  shift; cmd_exec "$@" ;;
  *) echo "usage: delegate {agent|check|exec [--headless] <prompt-file> <outfile>}" >&2; exit 2 ;;
esac

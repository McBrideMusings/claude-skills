#!/usr/bin/env bash
# herdr-agent — run one dispatched task as a LIVE interactive agent in its own herdr space.
#
#   herdr-agent run <kind> <prompt-file> <outfile> [-- <agent-arg>...]
#
# The herdr counterpart to `terminal run`. Same caller contract — prompt in a file,
# response in <outfile>, blocks until done — but the thing in the space is a real
# interactive agent session, not a piped one-shot:
#
#   * you can switch to its space and type at it while it works, or take it over after
#   * it outlives this Claude session (the space and the agent stay up if we die)
#   * it writes <outfile> ITSELF, because an interactive TUI has no stdout to tee.
#     The instruction to do that is appended to the prompt below — that appended
#     paragraph IS the outfile contract. Remove it and the caller reads an empty file.
#
# Completion is `herdr agent prompt --wait`, not a sentinel: herdr already tracks the
# agent's lifecycle state, so we wait on `idle`/`done` rather than polling a file.
#
# The space is deliberately LEFT OPEN and never focused. Focusing marks it seen and
# collapses a `done` into `idle`; closing it throws away the session you might want
# to take over. Whoever owns the worker closes it.
set -eu

TIMEOUT_MS=2400000   # 40m, matching `terminal run`'s ceiling
READY_MS=120000      # how long to wait for the agent TUI to come up in the pane

need() { command -v "$1" >/dev/null 2>&1 || { echo "herdr-agent: missing '$1'" >&2; exit 1; }; }

# Block until <pane> is idle at its own shell — one foreground process, and it's the shell.
wait_pane_ready() {
  local pane="$1" i=0
  while [ "$i" -lt 40 ]; do
    if herdr pane process-info --pane "$pane" 2>/dev/null | jq -e '
          .result.process_info
          | (.foreground_processes | length) == 1
            and .foreground_processes[0].pid == .shell_pid' >/dev/null; then
      return 0
    fi
    sleep 0.5; i=$((i + 1))
  done
  return 1
}

# Start a standalone top-level space (herdr workspace) in $PWD and set pane/tab/ws/where.
# `herdr workspace create` has no parent option, so this space sits at the top of the sidebar.
new_space() {
  local created
  created="$(herdr workspace create --cwd "$PWD" --label "$slug" --no-focus)" || {
    echo "herdr-agent: could not create a space in $PWD" >&2; return 1; }
  pane="$(printf '%s' "$created" | jq -r '.result.root_pane.pane_id // empty')"
  tab="$(printf '%s' "$created" | jq -r '.result.tab.tab_id // empty')"
  ws="$(printf '%s' "$created" | jq -r '.result.workspace.workspace_id // empty')"
  where="standalone space $slug ($ws)"
  [ -n "$pane" ] || { echo "herdr-agent: no pane id came back for $where" >&2; return 1; }
}

# Pick where the agent's pane goes, and set pane/tab/ws/where for the caller. The agent
# always gets a space of its own, never a tab of the caller's. A linked worktree of a repo
# herdr tracks gets a child space nested under the repo's space, the same place
# `herdr worktree create --workspace` puts one. Everything else gets a standalone top-level
# space: the main checkout, a worktree herdr refuses (one of the skills submodule), a
# directory that is not a repo. The only tab ever added is `dispatch-<pid>`, in a child
# space that was already open when we got here.
place_pane() {
  local gitdir common top repo_ws opened already created id
  gitdir="$(git -C "$PWD" rev-parse --absolute-git-dir 2>/dev/null || true)"
  common="$(git -C "$PWD" rev-parse --path-format=absolute --git-common-dir 2>/dev/null || true)"
  if [ -z "$gitdir" ] || [ "$gitdir" = "$common" ]; then
    new_space; return
  fi
  top="$(git -C "$PWD" rev-parse --show-toplevel)"
  repo_ws="$(herdr workspace list | jq -r --arg key "$common" '
    [.result.workspaces[] | select(.worktree.repo_key == $key and .worktree.is_linked_worktree == false)
     | .workspace_id][0] // empty')"
  # `workspace list` leaves `.worktree` off some workspaces; ask each of those which
  # repo it is the source checkout of.
  if [ -z "$repo_ws" ]; then
    for id in $(herdr workspace list | jq -r '.result.workspaces[] | select(.worktree == null) | .workspace_id'); do
      if [ "$(herdr worktree list --workspace "$id" 2>/dev/null | jq -r '.result.source.repo_key // empty')" = "$common" ]; then
        repo_ws="$id"; break
      fi
    done
  fi
  [ -n "$repo_ws" ] || echo "herdr-agent: no open workspace for repo $common — the worktree's space opens at top level" >&2
  # herdr only opens a space for a worktree of a repo it tracks; one of a submodule
  # (the skills repo) is refused.
  if ! opened="$(herdr worktree open ${repo_ws:+--workspace "$repo_ws"} --path "$top" --no-focus 2>/dev/null)"; then
    echo "herdr-agent: herdr cannot open a child space for $top; starting a standalone space in it instead" >&2
    new_space; return
  fi
  ws="$(printf '%s' "$opened" | jq -r '.result.workspace.workspace_id // empty')"
  already="$(printf '%s' "$opened" | jq -r '.result.already_open')"
  if [ "$already" = "true" ]; then
    created="$(herdr tab create --workspace "$ws" --cwd "$PWD" --label "$slug" --no-focus)" || {
      echo "herdr-agent: could not create a tab in space $ws" >&2; return 1; }
    pane="$(printf '%s' "$created" | jq -r '.result.root_pane.pane_id // empty')"
    tab="$(printf '%s' "$created" | jq -r '.result.tab.tab_id // empty')"
  else
    pane="$(printf '%s' "$opened" | jq -r '.result.root_pane.pane_id // empty')"
    tab="$(printf '%s' "$opened" | jq -r '.result.tab.tab_id // empty')"
  fi
  where="child space $(printf '%s' "$opened" | jq -r '.result.workspace.label // empty') ($ws)${repo_ws:+ of $repo_ws}"
  [ -n "$pane" ] || { echo "herdr-agent: no pane id came back for $where" >&2; return 1; }
}

# True once <text> appears in the agent's pane, polling for up to 15s.
pane_shows() {
  local i=0
  while [ "$i" -lt 10 ]; do
    herdr pane read "$pane" --lines 120 2>/dev/null | grep -qF "$1" && return 0
    sleep 1.5; i=$((i + 1))
  done
  return 1
}

# Given the state the prompt's own --wait matched, wait until the agent is idle or done.
# Each time it stops on a prompt, say so at once — nobody may be looking at its pane —
# then wait for someone to answer it and carry on. `agent wait` matches the current
# state immediately, so it is only called once the agent is known to be past idle.
wait_finished() {
  local status="$1"
  while :; do
    case "$status" in
      idle|done) return 0 ;;
      blocked)
        echo "herdr-agent: $slug is blocked on a prompt in pane $pane, $where — answer it there" >&2
        # A declined prompt can go straight to idle or done without passing through working.
        status="$(herdr agent wait "$slug" --until working --until idle --until 'done' --timeout "$TIMEOUT_MS" 2>/dev/null \
          | jq -r '.result.agent.agent_status // empty')" || return 1
        continue ;;
      working) ;;
      *) return 1 ;;
    esac
    status="$(herdr agent wait "$slug" --until idle --until 'done' --until blocked --timeout "$TIMEOUT_MS" 2>/dev/null \
      | jq -r '.result.agent.agent_status // empty')" || return 1
  done
}

cmd_run() {
  local kind="${1:-}" promptfile="${2:-}" outfile="${3:-}"
  if [ -z "$kind" ] || [ -z "$promptfile" ] || [ -z "$outfile" ]; then
    echo "usage: herdr-agent run <kind> <prompt-file> <outfile> [-- <agent-arg>...]" >&2; return 2
  fi
  shift 3
  [ "${1:-}" = "--" ] && shift || true
  [ -f "$promptfile" ] || { echo "herdr-agent: prompt file not found: $promptfile" >&2; return 1; }

  [ "${HERDR_ENV:-}" = "1" ] || { echo "herdr-agent: not running inside herdr (HERDR_ENV != 1)" >&2; return 1; }
  need herdr; need jq

  # Agent names must match [a-z][a-z0-9_-]{0,31} and be unique among live agents.
  local slug="dispatch-$$"

  : > "$outfile"

  local pane tab ws where
  place_pane || return 1

  # `agent start` requires the pane to be sitting at its interactive shell prompt. A space
  # created a moment ago is still spawning its shell, and starting into that returns
  # `agent_pane_busy`. The pane is ready when the only foreground process IS the shell.
  wait_pane_ready "$pane" || { echo "herdr-agent: pane $pane never reached a shell prompt — leaving space $ws open" >&2; return 1; }

  if ! herdr agent start "$slug" --kind "$kind" --pane "$pane" --timeout "$READY_MS" -- "$@" >/dev/null; then
    echo "herdr-agent: '$kind' did not come up in pane $pane — leaving space $ws open to inspect" >&2
    return 1
  fi
  echo "herdr-agent: $slug started in $where, pane $pane" >&2

  # An interactive agent prints to a TUI, so there is nothing to tee. Tell it where to
  # put the answer; the caller reads that file exactly as it reads `terminal run`'s.
  local text
  text="$(cat "$promptfile")
"'
────────────────────────────────────────────────────────────
HOW TO RETURN YOUR ANSWER — required, do this last:
Write your complete response to the file below, as a whole file, in Markdown.
Do not summarise it there; that file IS your answer and is the only part that is read.

  '"$outfile"'
────────────────────────────────────────────────────────────'

  # --wait blocks on the agent's own lifecycle state, matching only states seen after the
  # submission. Right after start, the TUI can report ready while still dropping input:
  # the prompt then shows up in the input box seconds later, unsent, or not at all.
  local first reply
  reply="$(herdr agent prompt "$slug" "$text" --wait --until idle --until 'done' --until blocked --timeout "$TIMEOUT_MS" 2>&1)" || true
  first="$(printf '%s' "$reply" | jq -r '.result.agent.agent_status // empty' 2>/dev/null)" || first=""
  if [ -z "$first" ]; then
    echo "herdr-agent: prompt to $slug did not register: $(printf '%s' "$reply" | head -c 200)" >&2
    local line attempt
    line="$(head -n 1 "$promptfile")"
    for attempt in 1 2; do
      pane_shows "$line" && break
      [ "$attempt" = 1 ] && herdr agent prompt "$slug" "$text" >/dev/null 2>&1 || true
    done
    if pane_shows "$line"; then
      herdr agent send-keys "$slug" enter >/dev/null 2>&1 || true
      first="$(herdr agent wait "$slug" --until working --until blocked --timeout 15000 2>/dev/null \
        | jq -r '.result.agent.agent_status // empty')" || first=""
    fi
  fi
  wait_finished "$first" || echo "herdr-agent: stopped waiting on $slug — its pane is $pane" >&2

  # The agent may have finished without writing the file (ignored the instruction, hit a
  # permission wall, crashed). Its pane still holds the answer, so scrape rather than
  # hand the caller an empty file — and say which one happened.
  if [ ! -s "$outfile" ]; then
    echo "herdr-agent: $kind wrote nothing to $outfile — falling back to its pane output" >&2
    herdr pane read "$pane" --lines 600 > "$outfile" 2>/dev/null || true
  fi

  echo "herdr-agent: $kind finished → $outfile (space $ws left open — switch to it to take over, close it when done)"
}

case "${1:-}" in
  run) shift; cmd_run "$@" ;;
  *) echo "usage: herdr-agent run <kind> <prompt-file> <outfile> [-- <agent-arg>...]" >&2; exit 2 ;;
esac
